---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = 'tel:+34605984005';
const whatsapp = 'https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto';
---
<Layout lang={lang} title="Limpieza Fin de Obra en Las Merindades | Reforma y Obra Nueva · Limpiezas El Valle" description="Limpieza especializada tras reformas y obra nueva en Las Merindades. Eliminación de polvo de escayola, restos de materiales y silicona. Presupuesto según m².">
  <Header lang={lang} page="" />
  <main>

    <!-- HERO -->
    <section class="bg-eco-900 text-white py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block bg-eco-700 text-eco-100 text-xs font-semibold px-4 py-1.5 mb-6 uppercase tracking-widest">Fin de Obra · Las Merindades</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6">
          Limpieza Fin de Obra<br/>en <span class="text-eco-400">Las Merindades</span>
        </h1>
        <p class="text-eco-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          Dejamos tu vivienda, local o nave lista para entrar desde el primer día. Eliminamos polvo de escayola, restos de materiales, salpicaduras de pintura y silicona con técnica y maquinaria profesional.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Pedir presupuesto
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border border-eco-500 text-eco-200 hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- QUÉ INCLUYE -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Servicio completo</span>
          <h2 class="text-3xl font-extrabold text-gray-900">¿Qué incluye la limpieza fin de obra?</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { icon: '🧹', title: 'Polvo de obra y escayola', desc: 'Eliminación completa del polvo fino de construcción en todas las superficies, rincones y techos.' },
            { icon: '🪟', title: 'Ventanas y marcos', desc: 'Limpieza exhaustiva de cristales, marcos, perfiles y herrajes de nueva instalación.' },
            { icon: '🔧', title: 'Silicona y pintura', desc: 'Retirada de restos de silicona, salpicaduras de pintura y adhesivos de superficies y sanitarios.' },
            { icon: '🪴', title: 'Suelos y alicatados', desc: 'Limpieza de pavimentos, azulejos y juntas eliminando lechada de obra y residuos.' },
            { icon: '🚿', title: 'Sanitarios nuevos', desc: 'Desembalaje y primera limpieza de inodoros, lavabos, platos de ducha y bañeras.' },
            { icon: '🍳', title: 'Cocina y radiadores', desc: 'Desengrase de cocinas nuevas, limpieza de radiadores, carpintería y elementos de acabado.' },
          ].map(f => (
            <div class="bg-white border border-gray-200 p-6">
              <div class="text-3xl mb-3">{f.icon}</div>
              <h3 class="font-bold text-gray-900 mb-2">{f.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRECIOS -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Tarifas orientativas</span>
          <h2 class="text-3xl font-extrabold text-gray-900">Precios limpieza fin de obra</h2>
        </div>
        <div class="border border-gray-200 overflow-hidden">
          <div class="bg-eco-900 text-white px-6 py-3 text-sm font-bold uppercase tracking-wider">Presupuesto según m² y estado de la obra</div>
          {[
            { item: 'Piso/Apartamento (hasta 80 m²)', price: 'desde 150 €' },
            { item: 'Casa unifamiliar', price: 'desde 250 €' },
            { item: 'Local comercial', price: 'desde 200 €' },
            { item: 'Desplazamiento (fuera de Espinosa)', price: '+1 €/km' },
          ].map(p => (
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors">
              <span class="text-gray-700">{p.item}</span>
              <span class="font-bold text-eco-700 ml-4 whitespace-nowrap">{p.price}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-400 text-xs mt-4">* El presupuesto final se calcula tras valorar los m², el tipo de obra y el estado del espacio. Contacta para un presupuesto a medida.</p>
      </div>
    </section>

    <!-- PROCESO -->
    <section class="py-16 md:py-20 bg-eco-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-500 pl-6 mb-12">
          <span class="text-eco-400 font-semibold text-sm uppercase tracking-widest block mb-2">Cómo trabajamos</span>
          <h2 class="text-3xl font-extrabold">El proceso en 3 pasos</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { num: '01', title: 'Valoración y presupuesto', desc: 'Cuéntanos el tipo de obra, los m² y la zona. Te enviamos un presupuesto detallado sin coste ni compromiso.' },
            { num: '02', title: 'Limpieza profesional', desc: 'Nuestro equipo acude equipado con maquinaria y productos específicos para limpieza de obra en Las Merindades.' },
            { num: '03', title: 'Entrega y revisión', desc: 'Antes de irnos hacemos una revisión final contigo para asegurarnos de que el espacio queda impecable.' },
          ].map(step => (
            <div class="border border-eco-700 p-6">
              <div class="text-eco-400 text-4xl font-extrabold mb-4">{step.num}</div>
              <h3 class="font-bold text-white text-lg mb-3">{step.title}</h3>
              <p class="text-eco-300 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-16 bg-eco-700">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <h2 class="text-3xl font-extrabold mb-4">¿Tienes una obra reciente?</h2>
        <p class="text-eco-100 mb-8">Llámanos o escríbenos por WhatsApp. Atendemos de lunes a viernes de 9:00 a 19:00 h en toda la comarca de Las Merindades.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Llamar: 605 984 005
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border-2 border-white text-white hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

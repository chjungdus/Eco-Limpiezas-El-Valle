---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Servicios from '../components/Servicios.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
---
<Layout lang={lang} title="Servicios de Limpieza en Las Merindades | Doméstica, Tapicerías, Fin de Obra · Limpiezas El Valle" description="Limpieza doméstica, fin de obra, tapicerías y cristales en Las Merindades y Burgos. Precios claros, personal cualificado, horarios flexibles. Presupuesto sin compromiso.">
  <Header lang={lang} page="servicios" />
  <main><Servicios lang={lang} /></main>
  <Footer lang={lang} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Servicios from '../components/Servicios.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
---
<Layout lang={lang} title="Servicios de Limpieza en Espinosa de los Monteros | Limpiezas El Valle" description="Limpieza doméstica, fin de obra, tapicerías, limpieza profunda y cristales en Espinosa de los Monteros y Las Merindades. Precios claros, personal cualificado. Presupuesto sin compromiso.">
  <Header lang={lang} page="servicios" />
  <main><Servicios lang={lang} /></main>
  <Footer lang={lang} />
</Layout>

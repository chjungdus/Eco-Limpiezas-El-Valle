---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = 'tel:+34605984005';
const whatsapp = 'https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto';
---
<Layout lang={lang} title="Limpieza Profunda en Espinosa de los Monteros y Las Merindades | Limpiezas El Valle" description="Servicio de limpieza profunda para hogares y locales en Espinosa de los Monteros y Las Merindades. Cocinas, baños, suelos, armarios. Presupuesto sin compromiso.">
  <Header lang={lang} page="" />
  <main>

    <!-- HERO -->
    <section class="bg-eco-900 text-white py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block bg-eco-700 text-eco-100 text-xs font-semibold px-4 py-1.5 mb-6 uppercase tracking-widest">Limpieza Profunda · Espinosa de los Monteros</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6">
          Limpieza Profunda<br/>en <span class="text-eco-400">Espinosa de los Monteros</span>
        </h1>
        <p class="text-eco-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          Una limpieza profunda va mucho más allá del mantenimiento habitual. Limpiamos a fondo cocinas, baños, suelos, armarios, electrodomésticos y rincones difíciles para dejar el espacio completamente renovado.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Pedir presupuesto
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border border-eco-500 text-eco-200 hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- DIFERENCIA LIMPIEZA PROFUNDA -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">¿Cuándo la necesitas?</span>
          <h2 class="text-3xl font-extrabold text-gray-900">¿En qué se diferencia de la limpieza regular?</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <div class="bg-white border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900 text-lg mb-4 border-b border-gray-100 pb-3">Limpieza de mantenimiento</h3>
            <ul class="space-y-2">
              {['Superficies visibles y accesibles', 'Aspirado y fregado de suelos', 'Limpieza de baños y cocina en general', 'Desempolvado de muebles', 'Ideal para mantenimiento semanal o quincenal'].map(i => (
                <li class="flex items-start gap-2 text-gray-600 text-sm">
                  <svg class="w-3.5 h-3.5 text-gray-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-eco-900 text-white p-6">
            <h3 class="font-bold text-white text-lg mb-4 border-b border-eco-700 pb-3">Limpieza profunda</h3>
            <ul class="space-y-2">
              {['Interior de armarios, cajones y estanterías', 'Desengrase total de cocina y electrodomésticos', 'Juntas, azulejos y rincones difíciles', 'Limpieza detrás y debajo de muebles', 'Calderetas, rejillas y conductos de ventilación', 'Ideal antes/después de mudanza, tras enfermedad o por temporada'].map(i => (
                <li class="flex items-start gap-2 text-eco-200 text-sm">
                  <svg class="w-3.5 h-3.5 text-eco-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Cuándo es ideal -->
        <div class="border-l-4 border-eco-600 pl-6 mb-8">
          <h3 class="text-xl font-extrabold text-gray-900">¿Cuándo es ideal una limpieza profunda?</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            { icon: '📦', label: 'Antes o después de una mudanza' },
            { icon: '🌸', label: 'Limpieza de primavera' },
            { icon: '🏥', label: 'Tras una enfermedad prolongada' },
            { icon: '🏡', label: 'Viviendas vacías o de segunda mano' },
            { icon: '🎄', label: 'Antes de las fiestas o eventos' },
            { icon: '📅', label: 'Limpieza anual a fondo' },
          ].map(c => (
            <div class="flex items-center gap-3 bg-white border border-gray-200 px-4 py-3">
              <span class="text-2xl">{c.icon}</span>
              <span class="text-gray-700 text-sm font-medium">{c.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRECIOS -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Tarifas orientativas</span>
          <h2 class="text-3xl font-extrabold text-gray-900">Precios limpieza profunda</h2>
        </div>
        <div class="border border-gray-200 overflow-hidden">
          <div class="bg-eco-900 text-white px-6 py-3 text-sm font-bold uppercase tracking-wider">Presupuesto según m², número de estancias y estado del inmueble</div>
          {[
            { item: 'Piso/Apartamento (1–2 habitaciones)', price: 'desde 90 €' },
            { item: 'Piso/Apartamento (3–4 habitaciones)', price: 'desde 130 €' },
            { item: 'Casa completa', price: 'desde 180 €' },
            { item: 'Local o negocio', price: 'Presupuesto personalizado' },
          ].map(p => (
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors">
              <span class="text-gray-700">{p.item}</span>
              <span class="font-bold text-eco-700 ml-4 whitespace-nowrap">{p.price}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-400 text-xs mt-4">* El presupuesto final depende del estado real del inmueble, número de estancias y elementos a tratar. Contacta para una valoración sin compromiso.</p>
      </div>
    </section>

    <!-- PROCESO -->
    <section class="py-16 md:py-20 bg-eco-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-500 pl-6 mb-12">
          <span class="text-eco-400 font-semibold text-sm uppercase tracking-widest block mb-2">Cómo trabajamos</span>
          <h2 class="text-3xl font-extrabold">El proceso en 3 pasos</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { num: '01', title: 'Consulta y presupuesto', desc: 'Cuéntanos el tipo de inmueble, número de habitaciones y el estado general. Te enviamos un presupuesto personalizado sin coste.' },
            { num: '02', title: 'Limpieza en profundidad', desc: 'Acudimos con productos y maquinaria profesional. Trabajamos de manera sistemática estancia por estancia para no pasar nada por alto.' },
            { num: '03', title: 'Revisión y satisfacción', desc: 'Al terminar hacemos una revisión contigo. Si algo no está a tu gusto, lo repetimos sin coste adicional.' },
          ].map(step => (
            <div class="border border-eco-700 p-6">
              <div class="text-eco-400 text-4xl font-extrabold mb-4">{step.num}</div>
              <h3 class="font-bold text-white text-lg mb-3">{step.title}</h3>
              <p class="text-eco-300 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-16 bg-eco-700">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <h2 class="text-3xl font-extrabold mb-4">¿Necesitas una limpieza profunda?</h2>
        <p class="text-eco-100 mb-8">Llámanos o escríbenos por WhatsApp. Atendemos de lunes a viernes de 9:00 a 19:00 h en Espinosa de los Monteros y toda la comarca de Las Merindades.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Llamar: 605 984 005
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border-2 border-white text-white hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

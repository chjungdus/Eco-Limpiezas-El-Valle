---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = 'tel:+34605984005';
const whatsapp = 'https://wa.me/34605984005?text=Hello%2C%20I%20would%20like%20to%20request%20a%20quote';
---
<Layout lang={lang} title="Post-Construction Cleaning in Las Merindades | New Build & Renovation · Limpiezas El Valle" description="Specialist post-construction cleaning after renovations in Las Merindades. Dust, plaster, silicone removal. Quote by m².">
  <Header lang={lang} page="" />
  <main>

    <!-- HERO -->
    <section class="bg-eco-900 text-white py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block bg-eco-700 text-eco-100 text-xs font-semibold px-4 py-1.5 mb-6 uppercase tracking-widest">Post-Construction · Las Merindades</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6">
          Post-Construction Cleaning<br/>in <span class="text-eco-400">Las Merindades</span>
        </h1>
        <p class="text-eco-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          We leave your home, commercial space or warehouse ready to move in from day one. We remove plaster dust, material residues, paint splashes and silicone with professional techniques and machinery.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Request a quote
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border border-eco-500 text-eco-200 hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- WHAT'S INCLUDED -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Full service</span>
          <h2 class="text-3xl font-extrabold text-gray-900">What's included?</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { icon: '🧹', title: 'Construction dust & plaster', desc: 'Complete removal of fine construction dust from all surfaces, corners and ceilings.' },
            { icon: '🪟', title: 'Windows & frames', desc: 'Thorough cleaning of newly installed glass panes, frames, profiles and hardware.' },
            { icon: '🔧', title: 'Silicone & paint', desc: 'Removal of silicone residues, paint splashes and adhesives from surfaces and sanitary ware.' },
            { icon: '🪴', title: 'Floors & tiles', desc: 'Cleaning of flooring, tiles and grout to remove construction cement and residues.' },
            { icon: '🚿', title: 'New sanitary ware', desc: 'Unpacking and first clean of toilets, basins, shower trays and baths.' },
            { icon: '🍳', title: 'Kitchen & radiators', desc: 'Degreasing of new kitchens, cleaning of radiators, joinery and finishing elements.' },
          ].map(f => (
            <div class="bg-white border border-gray-200 p-6">
              <div class="text-3xl mb-3">{f.icon}</div>
              <h3 class="font-bold text-gray-900 mb-2">{f.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Indicative rates</span>
          <h2 class="text-3xl font-extrabold text-gray-900">Post-construction cleaning prices</h2>
        </div>
        <div class="border border-gray-200 overflow-hidden">
          <div class="bg-eco-900 text-white px-6 py-3 text-sm font-bold uppercase tracking-wider">Quote based on m² and site condition</div>
          {[
            { item: 'Flat/Apartment (up to 80 m²)', price: 'from €150' },
            { item: 'Detached house', price: 'from €250' },
            { item: 'Commercial space', price: 'from €200' },
            { item: 'Travel (outside Espinosa)', price: '+€1/km' },
          ].map(p => (
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors">
              <span class="text-gray-700">{p.item}</span>
              <span class="font-bold text-eco-700 ml-4 whitespace-nowrap">{p.price}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-400 text-xs mt-4">* Final quote calculated after assessing m², type of construction and site condition. Contact us for a tailored quote.</p>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="py-16 md:py-20 bg-eco-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-500 pl-6 mb-12">
          <span class="text-eco-400 font-semibold text-sm uppercase tracking-widest block mb-2">How we work</span>
          <h2 class="text-3xl font-extrabold">The process in 3 steps</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { num: '01', title: 'Assessment & quote', desc: 'Tell us the type of build, the m² and location. We send you a detailed, free, no-obligation quote.' },
            { num: '02', title: 'Professional cleaning', desc: 'Our team arrives with machinery and products specifically suited to post-construction cleaning in Las Merindades.' },
            { num: '03', title: 'Handover & review', desc: 'Before we leave we carry out a final walkthrough with you to ensure the space is spotless.' },
          ].map(step => (
            <div class="border border-eco-700 p-6">
              <div class="text-eco-400 text-4xl font-extrabold mb-4">{step.num}</div>
              <h3 class="font-bold text-white text-lg mb-3">{step.title}</h3>
              <p class="text-eco-300 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="py-16 bg-eco-700">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <h2 class="text-3xl font-extrabold mb-4">Have you recently finished building work?</h2>
        <p class="text-eco-100 mb-8">Call us or message on WhatsApp. Available Monday to Friday, 9:00–19:00, throughout Las Merindades.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call: 605 984 005
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border-2 border-white text-white hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

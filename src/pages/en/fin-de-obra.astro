---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const lang = 'en' as const;
---
<Layout lang={lang} title="Post-Construction Cleaning in Las Merindades | New Builds & Renovations · Limpiezas El Valle" description="Specialist post-construction cleaning after renovations and new builds in Las Merindades, Burgos. Dust, plaster, silicone removal. Quote by m².">
  <Header lang={lang} page="fin-de-obra" />
  <main class="bg-white">

    <!-- Hero -->
    <section class="bg-eco-900 text-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="inline-block bg-eco-700 text-eco-100 text-xs font-bold uppercase tracking-widest px-3 py-1 mb-6">Post-Construction · Las Merindades</span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Post-Construction Cleaning<br class="hidden sm:block"/> in Las Merindades
        </h1>
        <p class="text-eco-200 text-lg md:text-xl max-w-2xl mb-8">
          Specialist cleaning after renovations, new builds and refurbishments. We remove plaster dust, silicone, material residues and paint splashes so the space is ready for use from day one.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:+34605984005"
            class="inline-flex items-center justify-center gap-2 bg-white text-eco-900 hover:bg-eco-100 px-6 py-3 font-bold text-sm transition-colors duration-150">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Call: 605 984 005
          </a>
          <a href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-eco-800 px-6 py-3 font-bold text-sm transition-colors duration-150">
            Free Quote via WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- What's included -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-12">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Full service</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">What's included in post-construction cleaning?</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            'Removal of plaster and construction dust',
            'Cleaning of new floors, tiles and cladding',
            'Removal of construction material residues',
            'Glazing and joinery: removal of splashes and stickers',
            'Newly installed bathrooms and kitchens',
            'Removal of paint and silicone from surfaces',
            'Façades, access areas and common spaces',
            'Vacuuming and mopping of all rooms',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white border border-gray-100 p-4">
              <svg class="w-4 h-4 text-eco-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700 text-sm">{item}</span>
            </div>
          ))}
        </div>
        <div class="mt-8 bg-eco-50 border border-eco-200 p-5">
          <p class="text-eco-800 text-sm font-medium">
            Quotes are calculated <strong>per square metre</strong> based on the type of work and level of soiling. Free pre-visit available for large properties.
          </p>
        </div>
      </div>
    </section>

    <!-- Prices -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Indicative rates</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Post-construction cleaning prices</h2>
          <p class="text-gray-500 mt-3 text-sm">Final price depends on square metres and level of soiling. Free no-obligation quote.</p>
        </div>
        <div class="border border-gray-200">
          <div class="bg-eco-900 text-white px-5 py-3 grid grid-cols-2">
            <span class="text-xs font-bold uppercase tracking-wider">Property type</span>
            <span class="text-xs font-bold uppercase tracking-wider text-right">Price from</span>
          </div>
          {[
            { item: 'Flat / Apartment', price: '€150' },
            { item: 'Detached house', price: '€250' },
            { item: 'Commercial premises', price: '€200' },
            { item: 'Travel outside Espinosa', price: '+€1/km' },
          ].map(row => (
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-gray-100 last:border-0 even:bg-gray-50">
              <span class="text-sm text-gray-700">{row.item}</span>
              <span class="text-sm font-bold text-eco-700">from {row.price}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-400 text-xs mt-4">We also quote per m² (€4–6/m²). VAT not included.</p>
      </div>
    </section>

    <!-- Process -->
    <section class="py-16 md:py-20 bg-eco-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-400 pl-6 mb-12">
          <span class="text-eco-300 font-semibold text-sm uppercase tracking-widest block mb-2">How we work</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold">3-step cleaning process</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            {
              step: '01',
              title: 'Property assessment',
              desc: 'We assess the surface area, type of work carried out and level of soiling. You receive a fixed quote per square metre or a set price as appropriate.',
            },
            {
              step: '02',
              title: 'Specialist cleaning',
              desc: 'We use industrial machinery and products specifically designed for construction dust, silicone, plaster, paint and cement. We work in phases to protect new finishes.',
            },
            {
              step: '03',
              title: 'Inspection & handover',
              desc: 'We inspect every room before finishing. The property is ready for handover, letting or moving in from day one.',
            },
          ].map(s => (
            <div class="border border-eco-700 p-6">
              <span class="text-eco-400 font-black text-4xl block mb-4 font-mono">{s.step}</span>
              <h3 class="font-bold text-lg mb-3 text-white">{s.title}</h3>
              <p class="text-eco-200 text-sm leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-4">Got a finished build that needs cleaning?</h2>
        <p class="text-gray-500 mb-8 text-lg">Call or message us and we'll give you a quote based on your square metres. We serve Espinosa de los Monteros and the entire Las Merindades and Burgos area.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+34605984005"
            class="inline-flex items-center justify-center gap-2 bg-eco-700 hover:bg-eco-800 text-white px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            +34 605 984 005
          </a>
          <a href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border-2 border-eco-700 text-eco-700 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = 'tel:+34605984005';
const whatsapp = 'https://wa.me/34605984005?text=Hello%2C%20I%20would%20like%20to%20request%20a%20quote';
---
<Layout lang={lang} title="Deep Cleaning Service in Espinosa de los Monteros & Las Merindades | Limpiezas El Valle" description="Professional deep cleaning for homes and businesses in Espinosa de los Monteros and Las Merindades. Kitchens, bathrooms, floors. Free quote.">
  <Header lang={lang} page="" />
  <main>

    <!-- HERO -->
    <section class="bg-eco-900 text-white py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block bg-eco-700 text-eco-100 text-xs font-semibold px-4 py-1.5 mb-6 uppercase tracking-widest">Deep Cleaning · Espinosa de los Monteros</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6">
          Deep Cleaning<br/>in <span class="text-eco-400">Espinosa de los Monteros</span>
        </h1>
        <p class="text-eco-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          A deep clean goes far beyond regular maintenance. We thoroughly clean kitchens, bathrooms, floors, wardrobes, appliances and hard-to-reach corners to leave the space completely refreshed.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Request a quote
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border border-eco-500 text-eco-200 hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- DIFFERENCE SECTION -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">When do you need it?</span>
          <h2 class="text-3xl font-extrabold text-gray-900">How does it differ from regular cleaning?</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <div class="bg-white border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900 text-lg mb-4 border-b border-gray-100 pb-3">Maintenance cleaning</h3>
            <ul class="space-y-2">
              {['Visible and accessible surfaces', 'Vacuuming and mopping floors', 'General bathroom and kitchen clean', 'Dusting furniture', 'Ideal for weekly or fortnightly upkeep'].map(i => (
                <li class="flex items-start gap-2 text-gray-600 text-sm">
                  <svg class="w-3.5 h-3.5 text-gray-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-eco-900 text-white p-6">
            <h3 class="font-bold text-white text-lg mb-4 border-b border-eco-700 pb-3">Deep cleaning</h3>
            <ul class="space-y-2">
              {['Inside wardrobes, drawers and shelving', 'Full degreasing of kitchen and appliances', 'Grout, tiles and hard-to-reach corners', 'Behind and under furniture', 'Drains, grilles and ventilation ducts', 'Ideal before/after moving, after illness or seasonally'].map(i => (
                <li class="flex items-start gap-2 text-eco-200 text-sm">
                  <svg class="w-3.5 h-3.5 text-eco-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="border-l-4 border-eco-600 pl-6 mb-8">
          <h3 class="text-xl font-extrabold text-gray-900">When is a deep clean ideal?</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            { icon: '📦', label: 'Before or after moving home' },
            { icon: '🌸', label: 'Spring cleaning' },
            { icon: '🏥', label: 'After a prolonged illness' },
            { icon: '🏡', label: 'Empty or second-hand properties' },
            { icon: '🎄', label: 'Before celebrations or events' },
            { icon: '📅', label: 'Annual thorough clean' },
          ].map(c => (
            <div class="flex items-center gap-3 bg-white border border-gray-200 px-4 py-3">
              <span class="text-2xl">{c.icon}</span>
              <span class="text-gray-700 text-sm font-medium">{c.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Indicative rates</span>
          <h2 class="text-3xl font-extrabold text-gray-900">Deep cleaning prices</h2>
        </div>
        <div class="border border-gray-200 overflow-hidden">
          <div class="bg-eco-900 text-white px-6 py-3 text-sm font-bold uppercase tracking-wider">Quote based on m², number of rooms and property condition</div>
          {[
            { item: 'Flat/Apartment (1–2 bedrooms)', price: 'from €90' },
            { item: 'Flat/Apartment (3–4 bedrooms)', price: 'from €130' },
            { item: 'Full house', price: 'from €180' },
            { item: 'Commercial premises', price: 'Custom quote' },
          ].map(p => (
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors">
              <span class="text-gray-700">{p.item}</span>
              <span class="font-bold text-eco-700 ml-4 whitespace-nowrap">{p.price}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-400 text-xs mt-4">* Final quote depends on the actual condition of the property, number of rooms and elements to be treated. Contact us for a no-obligation assessment.</p>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="py-16 md:py-20 bg-eco-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-500 pl-6 mb-12">
          <span class="text-eco-400 font-semibold text-sm uppercase tracking-widest block mb-2">How we work</span>
          <h2 class="text-3xl font-extrabold">The process in 3 steps</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { num: '01', title: 'Consultation & quote', desc: 'Tell us the property type, number of rooms and general condition. We send you a personalised, free quote.' },
            { num: '02', title: 'Deep cleaning', desc: 'We arrive with professional products and machinery, working systematically room by room so nothing is overlooked.' },
            { num: '03', title: 'Review & satisfaction', desc: 'When we finish we walk through the property with you. If anything is not to your satisfaction, we redo it at no extra charge.' },
          ].map(step => (
            <div class="border border-eco-700 p-6">
              <div class="text-eco-400 text-4xl font-extrabold mb-4">{step.num}</div>
              <h3 class="font-bold text-white text-lg mb-3">{step.title}</h3>
              <p class="text-eco-300 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="py-16 bg-eco-700">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <h2 class="text-3xl font-extrabold mb-4">Need a deep clean?</h2>
        <p class="text-eco-100 mb-8">Call us or message on WhatsApp. Available Monday to Friday, 9:00–19:00, in Espinosa de los Monteros and throughout Las Merindades.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call: 605 984 005
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border-2 border-white text-white hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

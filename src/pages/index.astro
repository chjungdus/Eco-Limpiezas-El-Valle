---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import SobreNosotros from '../components/SobreNosotros.astro';
import PorQueElegirnos from '../components/PorQueElegirnos.astro';
import ComoTrabajamos from '../components/ComoTrabajamos.astro';
import Referencias from '../components/Referencias.astro';
import Testimoniales from '../components/Testimoniales.astro';
import FAQ from '../components/FAQ.astro';
import ZonaDeTrabajo from '../components/ZonaDeTrabajo.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Servicios />
    <SobreNosotros />
    <PorQueElegirnos />
    <ComoTrabajamos />
    <Referencias />
    <Testimoniales />
    <FAQ />
    <ZonaDeTrabajo />
    <Contacto />
  </main>
  <Footer />
</Layout>

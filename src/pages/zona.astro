---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ZonaDeTrabajo from '../components/ZonaDeTrabajo.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
---
<Layout lang={lang} title="Zona de Servicio: Espinosa de los Monteros y Las Merindades | Limpiezas El Valle" description="Servicio de limpieza profesional en Espinosa de los Monteros y toda la comarca de Las Merindades. Villarcayo, Medina de Pomar, Valle de Mena y más. Llámanos.">
  <Header lang={lang} page="zona" />
  <main><ZonaDeTrabajo lang={lang} /></main>
  <Footer lang={lang} />
</Layout>

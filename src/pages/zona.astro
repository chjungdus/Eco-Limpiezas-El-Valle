---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ZonaDeTrabajo from '../components/ZonaDeTrabajo.astro';
import Footer from '../components/Footer.astro';
const lang = 'es' as const;
---
<Layout lang={lang} title="Limpieza en Las Merindades | Servicio a Domicilio · Limpiezas El Valle" description="Servicio de limpieza profesional en toda la comarca de Las Merindades, Burgos. Espinosa de los Monteros, Villarcayo, Medina de Pomar, Valle de Mena y más. Llámanos.">
  <Header lang={lang} page="zona" />
  <main><ZonaDeTrabajo lang={lang} /></main>
  <Footer lang={lang} />
</Layout>

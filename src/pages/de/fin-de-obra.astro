---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = 'tel:+34605984005';
const whatsapp = 'https://wa.me/34605984005?text=Hallo%2C%20ich%20m%C3%B6chte%20ein%20Angebot%20anfordern';
---
<Layout lang={lang} title="Baureinigung in Las Merindades | Neubau und Renovierung · Limpiezas El Valle" description="Spezialisierte Baureinigung nach Renovierungen in Las Merindades. Gipsstaub, Silikon und Baumaterial-Reste. Angebot nach m².">
  <Header lang={lang} page="" />
  <main>

    <!-- HERO -->
    <section class="bg-eco-900 text-white py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block bg-eco-700 text-eco-100 text-xs font-semibold px-4 py-1.5 mb-6 uppercase tracking-widest">Baureinigung · Las Merindades</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6">
          Baureinigung<br/>in <span class="text-eco-400">Las Merindades</span>
        </h1>
        <p class="text-eco-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          Wir hinterlassen Ihre Wohnung, Ihr Geschäft oder Ihre Halle ab dem ersten Tag bezugsfertig. Wir entfernen Gipsstaub, Baumaterialreste, Farbspritzer und Silikon mit professionellen Techniken und Maschinen.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Angebot anfordern
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border border-eco-500 text-eco-200 hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- WAS ENTHALTEN -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Vollständiger Service</span>
          <h2 class="text-3xl font-extrabold text-gray-900">Was ist enthalten?</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { icon: '🧹', title: 'Baustaub & Gips', desc: 'Vollständige Beseitigung von feinem Baustaub von allen Oberflächen, Ecken und Decken.' },
            { icon: '🪟', title: 'Fenster & Rahmen', desc: 'Gründliche Reinigung von neu eingebauten Scheiben, Rahmen, Profilen und Beschlägen.' },
            { icon: '🔧', title: 'Silikon & Farbe', desc: 'Entfernung von Silikonresten, Farbspritzern und Klebstoffen von Oberflächen und Sanitärgegenständen.' },
            { icon: '🪴', title: 'Böden & Fliesen', desc: 'Reinigung von Bodenbelägen, Fliesen und Fugen zur Entfernung von Baumörtel und Rückständen.' },
            { icon: '🚿', title: 'Neue Sanitärobjekte', desc: 'Auspacken und Erstreinigung von Toiletten, Waschbecken, Duschwannen und Badewannen.' },
            { icon: '🍳', title: 'Küche & Heizkörper', desc: 'Entfetten neuer Küchen, Reinigen von Heizkörpern, Tischlerarbeiten und Abschlusselementen.' },
          ].map(f => (
            <div class="bg-white border border-gray-200 p-6">
              <div class="text-3xl mb-3">{f.icon}</div>
              <h3 class="font-bold text-gray-900 mb-2">{f.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PREISE -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Richtwerte</span>
          <h2 class="text-3xl font-extrabold text-gray-900">Preise Baureinigung</h2>
        </div>
        <div class="border border-gray-200 overflow-hidden">
          <div class="bg-eco-900 text-white px-6 py-3 text-sm font-bold uppercase tracking-wider">Angebot nach m² und Zustand der Baustelle</div>
          {[
            { item: 'Wohnung (bis 80 m²)', price: 'ab 150 €' },
            { item: 'Einfamilienhaus', price: 'ab 250 €' },
            { item: 'Gewerbefläche', price: 'ab 200 €' },
            { item: 'Anfahrt (außerhalb Espinosa)', price: '+1 €/km' },
          ].map(p => (
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors">
              <span class="text-gray-700">{p.item}</span>
              <span class="font-bold text-eco-700 ml-4 whitespace-nowrap">{p.price}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-400 text-xs mt-4">* Endpreis wird nach Bewertung der m², Bauart und Zustand berechnet. Kontaktieren Sie uns für ein individuelles Angebot.</p>
      </div>
    </section>

    <!-- PROZESS -->
    <section class="py-16 md:py-20 bg-eco-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-500 pl-6 mb-12">
          <span class="text-eco-400 font-semibold text-sm uppercase tracking-widest block mb-2">So arbeiten wir</span>
          <h2 class="text-3xl font-extrabold">Der Prozess in 3 Schritten</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { num: '01', title: 'Bewertung & Angebot', desc: 'Teilen Sie uns die Bauart, die m² und den Standort mit. Wir senden Ihnen ein detailliertes, kostenloses und unverbindliches Angebot.' },
            { num: '02', title: 'Professionelle Reinigung', desc: 'Unser Team kommt mit Maschinen und Produkten, die speziell für die Baureinigung in Las Merindades geeignet sind.' },
            { num: '03', title: 'Übergabe & Abnahme', desc: 'Vor dem Verlassen führen wir gemeinsam mit Ihnen eine abschließende Begehung durch, um sicherzustellen, dass alles makellos ist.' },
          ].map(step => (
            <div class="border border-eco-700 p-6">
              <div class="text-eco-400 text-4xl font-extrabold mb-4">{step.num}</div>
              <h3 class="font-bold text-white text-lg mb-3">{step.title}</h3>
              <p class="text-eco-300 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINALER CTA -->
    <section class="py-16 bg-eco-700">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        <h2 class="text-3xl font-extrabold mb-4">Kürzlich Bauarbeiten abgeschlossen?</h2>
        <p class="text-eco-100 mb-8">Rufen Sie uns an oder schreiben Sie per WhatsApp. Erreichbar montags bis freitags von 9:00 bis 19:00 Uhr in der gesamten Comarca Las Merindades.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={phone} class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Anrufen: 605 984 005
          </a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 border-2 border-white text-white hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

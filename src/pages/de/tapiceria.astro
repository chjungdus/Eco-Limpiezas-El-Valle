---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const lang = 'de' as const;
---
<Layout lang={lang} title="Polsterreinigung in Espinosa de los Monteros | Sofas, Sessel, Matratzen · Limpiezas El Valle" description="Professionelle Polsterreinigung mit Kärcher in Espinosa de los Monteros und Las Merindades. Sofas, Sessel, Matratzen. Ab 40 €. Kostenloser Kostenvoranschlag.">
  <Header lang={lang} page="tapiceria" />
  <main class="bg-white">

    <!-- Hero -->
    <section class="bg-eco-900 text-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="inline-block bg-eco-700 text-eco-100 text-xs font-bold uppercase tracking-widest px-3 py-1 mb-6">Polster · Las Merindades</span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Polsterreinigung in<br class="hidden sm:block"/> Espinosa de los Monteros
        </h1>
        <p class="text-eco-200 text-lg md:text-xl max-w-2xl mb-8">
          Sofas, Sessel, Matratzen und gepolsterte Stühle. Professionelle Kärcher-Injektions- und Extraktionsgeräte zur Entfernung von Staub, Milben, Flecken und Gerüchen aus jedem Stoff.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:+34605984005"
            class="inline-flex items-center justify-center gap-2 bg-white text-eco-900 hover:bg-eco-100 px-6 py-3 font-bold text-sm transition-colors duration-150">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Anrufen: 605 984 005
          </a>
          <a href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-eco-800 px-6 py-3 font-bold text-sm transition-colors duration-150">
            Kostenvoranschlag per WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Was beinhaltet -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-12">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Vollständiger Service</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Was beinhaltet die Polsterreinigung?</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            'Zwei- und Dreisitzer-Sofas, Ecksofas und Chaiselongues',
            'Sessel und Lehnstühle jeder Polsterung',
            'Einzel- und Doppelmatratzen',
            'Esszimmerstühle und gepolsterte Hocker',
            'Kopfteile und gepolsterte Bänke',
            'Teppiche und Teppichböden',
            'Fahrzeugsitze und Polsterung',
            'Stoff-Vorhänge und Jalousien',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white border border-gray-100 p-4">
              <svg class="w-4 h-4 text-eco-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700 text-sm">{item}</span>
            </div>
          ))}
        </div>
        <div class="mt-8 bg-eco-50 border border-eco-200 p-5">
          <p class="text-eco-800 text-sm font-medium">
            Wir verwenden professionelle <strong>Kärcher-Injektions- und Extraktionsmaschinen</strong> — dieselbe Technologie wie im industriellen Reinigungsservice. Sichtbare Ergebnisse bereits nach der ersten Sitzung.
          </p>
        </div>
      </div>
    </section>

    <!-- Preise -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-600 pl-6 mb-10">
          <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">Richtwerte</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Preise für Polsterreinigung</h2>
          <p class="text-gray-500 mt-3 text-sm">Der Endpreis hängt von Stoffart und Zustand ab. Kostenloser unverbindlicher Kostenvoranschlag.</p>
        </div>
        <div class="border border-gray-200">
          <div class="bg-eco-900 text-white px-5 py-3 grid grid-cols-2">
            <span class="text-xs font-bold uppercase tracking-wider">Artikel</span>
            <span class="text-xs font-bold uppercase tracking-wider text-right">Preis ab</span>
          </div>
          {[
            { item: '2-Sitzer Sofa', price: '40 €' },
            { item: '3-Sitzer Sofa', price: '55 €' },
            { item: 'Sessel', price: '25 €' },
            { item: 'Einzelmatratze', price: '35 €' },
            { item: 'Doppelmatratze', price: '45 €' },
            { item: 'Esszimmerstuhl', price: '8 €' },
          ].map(row => (
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-gray-100 last:border-0 even:bg-gray-50">
              <span class="text-sm text-gray-700">{row.item}</span>
              <span class="text-sm font-bold text-eco-700">ab {row.price}</span>
            </div>
          ))}
        </div>
        <p class="text-gray-400 text-xs mt-4">Anfahrt außerhalb Espinosa de los Monteros: +1 €/km. Zzgl. MwSt.</p>
      </div>
    </section>

    <!-- Prozess -->
    <section class="py-16 md:py-20 bg-eco-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-l-4 border-eco-400 pl-6 mb-12">
          <span class="text-eco-300 font-semibold text-sm uppercase tracking-widest block mb-2">So arbeiten wir</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold">Reinigungsprozess in 3 Schritten</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            {
              step: '01',
              title: 'Bewertung & Angebot',
              desc: 'Sie beschreiben die Art des Polsters und seinen Zustand. Wir geben Ihnen einen Festpreis ohne Überraschungen, bevor wir beginnen.',
            },
            {
              step: '02',
              title: 'Professionelle Behandlung',
              desc: 'Wir tragen stoffspezifische Vorwäsche auf und verwenden Kärcher-Injektions- und Extraktionsgeräte für eine gründliche Tiefenreinigung.',
            },
            {
              step: '03',
              title: 'Trocknung & Übergabe',
              desc: 'Das Polster fühlt sich leicht feucht an und ist innerhalb von 2–4 Stunden vollständig getrocknet. Die meisten Flecken und Gerüche verschwinden in einer einzigen Sitzung.',
            },
          ].map(s => (
            <div class="border border-eco-700 p-6">
              <span class="text-eco-400 font-black text-4xl block mb-4 font-mono">{s.step}</span>
              <h3 class="font-bold text-lg mb-3 text-white">{s.title}</h3>
              <p class="text-eco-200 text-sm leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-4">Muss Ihr Sofa oder Ihre Matratze gereinigt werden?</h2>
        <p class="text-gray-500 mb-8 text-lg">Kontaktieren Sie uns für ein kostenloses, unverbindliches Angebot. Wir sind in Espinosa de los Monteros und der gesamten Region Las Merindades tätig.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+34605984005"
            class="inline-flex items-center justify-center gap-2 bg-eco-700 hover:bg-eco-800 text-white px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            +34 605 984 005
          </a>
          <a href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border-2 border-eco-700 text-eco-700 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Layout>

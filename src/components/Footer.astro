---
const year = new Date().getFullYear();

const services = [
  'Limpiezas Domésticas',
  'Limpieza de Fin de Obra',
  'Tapicerías en General',
  'Limpieza de Cristales',
  'Oficinas y Locales',
  'Comunidades de Vecinos',
];

const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#referencias', label: 'Sectores' },
  { href: '#zona', label: 'Zona de trabajo' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="bg-gray-900 text-gray-400">

  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 bg-eco-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M17.778 8.222A8 8 0 1 0 2.222 17.778C3.444 16 5 13 5 10c0-1.333.667-3 2-4 0 2 1 4 3 5 0-2 1-4 3-4-1 2-1 4 0 5 1-1 2-3 2-5 1.333 1.333 2 3 2 5 0 1-.5 2.5-2 4 2-1 3.5-3 3.778-6.778z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div>
            <span class="font-bold text-white text-base tracking-tight block">ECO-LIMPIEZAS</span>
            <span class="text-eco-500 text-xs font-semibold tracking-widest block">EL VALLE</span>
          </div>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed mb-6">
          Empresa de limpieza integral con sede en Espinosa de los Monteros, prestando servicio en toda la comarca de Las Merindades, Burgos.
        </p>
        <p class="text-gray-500 text-sm leading-relaxed">
          Especialistas en limpiezas domésticas, fin de obra, tapicerías y cristales para particulares y empresas. Productos ecológicos y horarios flexibles.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-6 pb-3 border-b border-gray-800">Navegación</h3>
        <ul class="space-y-3">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-gray-500 hover:text-white text-sm transition-colors duration-150">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-6 pb-3 border-b border-gray-800">Servicios</h3>
        <ul class="space-y-3">
          {services.map(s => (
            <li>
              <a href="#servicios" class="text-gray-500 hover:text-white text-sm transition-colors duration-150">
                {s}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-6 pb-3 border-b border-gray-800">Contacto</h3>
        <div class="space-y-5">
          <div>
            <p class="text-gray-600 text-xs uppercase tracking-wider mb-1">Responsable</p>
            <p class="text-gray-300 text-sm font-medium">Davinia Gómez Baranda</p>
          </div>
          <div>
            <p class="text-gray-600 text-xs uppercase tracking-wider mb-1">Teléfono</p>
            <a href="tel:+34605984005" class="text-gray-300 text-sm font-medium hover:text-white transition-colors">
              +34 605 984 005
            </a>
          </div>
          <div>
            <p class="text-gray-600 text-xs uppercase tracking-wider mb-1">Zona</p>
            <p class="text-gray-400 text-sm">Espinosa de los Monteros</p>
            <p class="text-gray-500 text-xs mt-0.5">Las Merindades, Burgos</p>
          </div>
          <div>
            <p class="text-gray-600 text-xs uppercase tracking-wider mb-2">WhatsApp</p>
            <a href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n%20sobre%20vuestros%20servicios%20de%20limpieza"
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20bd59] text-white px-4 py-2 font-semibold text-sm transition-colors duration-150">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Escribir por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-gray-600 text-sm">
        &copy; {year} Eco-Limpiezas El Valle. Todos los derechos reservados.
      </p>
      <p class="text-gray-700 text-sm">
        Espinosa de los Monteros · Las Merindades · Burgos
      </p>
    </div>
  </div>

</footer>

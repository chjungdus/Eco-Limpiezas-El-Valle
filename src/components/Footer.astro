---
const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#zona', label: 'Zona de Trabajo' },
  { href: '#contacto', label: 'Contacto' },
];

const services = [
  'Limpiezas Domésticas',
  'Limpieza de Fin de Obra',
  'Tapicerías en General',
  'Limpieza de Cristales',
];

const year = new Date().getFullYear();
---

<footer class="bg-eco-950 text-eco-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Main footer grid -->
    <div class="py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="#" class="flex items-center gap-2 mb-4">
          <div class="w-9 h-9 bg-eco-600 rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M17.778 8.222A8 8 0 1 0 2.222 17.778C3.444 16 5 13 5 10c0-1.333.667-3 2-4 0 2 1 4 3 5 0-2 1-4 3-4-1 2-1 4 0 5 1-1 2-3 2-5 1.333 1.333 2 3 2 5 0 1-.5 2.5-2 4 2-1 3.5-3 3.778-6.778z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div>
            <span class="font-bold text-white text-lg leading-tight block">Eco-Limpiezas</span>
            <span class="text-eco-400 text-xs font-medium leading-none block">El Valle</span>
          </div>
        </a>
        <p class="text-eco-400 text-sm leading-relaxed mb-6">
          Limpieza profesional con compromiso ecológico en Las Merindades, Burgos. Para particulares y empresas.
        </p>
        <!-- WhatsApp link -->
        <a
          href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n%20sobre%20vuestros%20servicios%20de%20limpieza"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20bd59] text-white px-4 py-2 rounded-lg font-semibold text-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-bold text-white text-sm uppercase tracking-widest mb-5">Navegación</h3>
        <ul class="space-y-3">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-eco-400 hover:text-white text-sm transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-bold text-white text-sm uppercase tracking-widest mb-5">Servicios</h3>
        <ul class="space-y-3">
          {services.map(s => (
            <li>
              <a href="#servicios" class="text-eco-400 hover:text-white text-sm transition-colors duration-200">
                {s}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-bold text-white text-sm uppercase tracking-widest mb-5">Contacto</h3>
        <div class="space-y-4">
          <div>
            <p class="text-eco-400 text-xs uppercase tracking-wider mb-1">Responsable</p>
            <p class="text-eco-100 text-sm font-medium">Davinia Gómez Baranda</p>
          </div>
          <div>
            <p class="text-eco-400 text-xs uppercase tracking-wider mb-1">Teléfono</p>
            <a href="tel:+34605984005" class="text-eco-100 text-sm font-medium hover:text-white transition-colors">
              +34 605 984 005
            </a>
          </div>
          <div>
            <p class="text-eco-400 text-xs uppercase tracking-wider mb-1">Zona</p>
            <p class="text-eco-100 text-sm">Espinosa de los Monteros</p>
            <p class="text-eco-400 text-xs">Las Merindades, Burgos</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-eco-900 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-eco-500 text-sm">
        &copy; {year} Eco-Limpiezas El Valle. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-1 text-eco-500 text-sm">
        <svg class="w-4 h-4 text-eco-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M17.778 8.222A8 8 0 1 0 2.222 17.778C3.444 16 5 13 5 10c0-1.333.667-3 2-4 0 2 1 4 3 5 0-2 1-4 3-4-1 2-1 4 0 5 1-1 2-3 2-5 1.333 1.333 2 3 2 5 0 1-.5 2.5-2 4 2-1 3.5-3 3.778-6.778z" clip-rule="evenodd"/>
        </svg>
        Hecho con compromiso en Las Merindades
      </div>
    </div>

  </div>
</footer>

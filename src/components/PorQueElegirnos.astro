---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);

const reasonKeys = [
  { titleKey: 'why1Title', descKey: 'why1Desc', icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { titleKey: 'why2Title', descKey: 'why2Desc', icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>` },
  { titleKey: 'why3Title', descKey: 'why3Desc', icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>` },
  { titleKey: 'why4Title', descKey: 'why4Desc', icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>` },
  { titleKey: 'why5Title', descKey: 'why5Desc', icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>` },
  { titleKey: 'why6Title', descKey: 'why6Desc', icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>` },
];

// Translations for the 6 reasons — kept inline per language for maintainability
const reasons = {
  es: [
    { title: 'Horarios Totalmente Flexibles', desc: 'Somos conscientes de que la mayoría de nuestros clientes tienen una agenda ocupada y no pueden reorganizar su día para adaptarse a un servicio de limpieza. Por eso ofrecemos plena flexibilidad horaria: trabajamos por la mañana, por la tarde, los fines de semana e incluso en días festivos cuando la situación lo requiere.' },
    { title: 'Atención Personalizada y Cercana', desc: 'No operamos con una estructura de gran empresa ni con protocolos rígidos. Cada cliente recibe un servicio diseñado específicamente para su situación: el tipo de espacio, la frecuencia que necesita, las zonas prioritarias y cualquier condición particular.' },
    { title: 'Compromiso con el Medioambiente', desc: 'Utilizamos exclusivamente productos de limpieza ecológicos, con certificación medioambiental, biodegradables y sin componentes tóxicos. Esta elección protege la salud de nuestros clientes y sus familias, incluyendo niños y animales domésticos.' },
    { title: 'Presupuesto Transparente', desc: 'Antes de comenzar cualquier trabajo, facilitamos siempre un presupuesto claro, detallado y sin letra pequeña. El precio acordado es el precio final: no hay cargos adicionales ni sorpresas en la factura.' },
    { title: 'Personal Cualificado', desc: 'Todo el personal que interviene en nuestros servicios cuenta con formación específica en técnicas de limpieza profesional, uso correcto de maquinaria y productos, y normas básicas de higiene y seguridad.' },
    { title: 'Empresa Local y de Confianza', desc: 'Conocemos el territorio y sus particularidades. Somos vecinos de Las Merindades y entendemos las necesidades de las personas y empresas de la comarca mejor que cualquier operador externo.' },
  ],
  en: [
    { title: 'Fully Flexible Hours', desc: 'We understand that most of our clients have busy schedules and cannot reorganise their day to accommodate a cleaning service. That is why we offer full schedule flexibility: we work mornings, afternoons, weekends and even bank holidays when required.' },
    { title: 'Personalised and Close Attention', desc: 'We do not operate with a large company structure or rigid protocols. Each client receives a service designed specifically for their situation: the type of space, the required frequency, priority areas and any particular conditions.' },
    { title: 'Environmental Commitment', desc: 'We exclusively use ecological cleaning products with environmental certification, biodegradable and free from toxic components. This choice protects the health of our clients and their families, including children and pets.' },
    { title: 'Transparent Pricing', desc: 'Before starting any work, we always provide a clear, detailed quote with no hidden charges. The agreed price is the final price: no additional charges or surprises on the invoice.' },
    { title: 'Qualified Staff', desc: 'All personnel involved in our services have specific training in professional cleaning techniques, correct use of machinery and products, and basic hygiene and safety standards.' },
    { title: 'Local and Trustworthy Company', desc: 'We know the territory and its characteristics. We are neighbours of Las Merindades and understand the needs of the people and businesses of the comarca better than any external operator.' },
  ],
  de: [
    { title: 'Vollständig flexible Zeiten', desc: 'Wir wissen, dass die meisten unserer Kunden einen vollen Terminkalender haben und ihren Tag nicht umstrukturieren können. Deshalb bieten wir vollständige Zeitflexibilität: Wir arbeiten morgens, nachmittags, an Wochenenden und auch an Feiertagen.' },
    { title: 'Persönliche und individuelle Betreuung', desc: 'Wir arbeiten nicht mit starren Protokollen eines Großunternehmens. Jeder Kunde erhält einen Dienst, der speziell auf seine Situation zugeschnitten ist: Art des Raums, erforderliche Häufigkeit, Prioritätsbereiche und besondere Bedingungen.' },
    { title: 'Ökologisches Engagement', desc: 'Wir verwenden ausschließlich ökologische Reinigungsprodukte mit Umweltzertifizierung, biologisch abbaubar und frei von Schadstoffen. Diese Wahl schützt die Gesundheit unserer Kunden und ihrer Familien, einschließlich Kinder und Haustiere.' },
    { title: 'Transparente Preisgestaltung', desc: 'Vor Beginn jeder Arbeit erstellen wir immer ein klares, detailliertes Angebot ohne Kleingedrucktes. Der vereinbarte Preis ist der Endpreis: keine zusätzlichen Kosten oder Überraschungen auf der Rechnung.' },
    { title: 'Qualifiziertes Personal', desc: 'Alle an unseren Dienstleistungen beteiligten Mitarbeiter haben eine spezifische Ausbildung in professionellen Reinigungstechniken, korrektem Einsatz von Maschinen und Produkten sowie grundlegenden Hygiene- und Sicherheitsstandards.' },
    { title: 'Lokales und vertrauenswürdiges Unternehmen', desc: 'Wir kennen das Gebiet und seine Besonderheiten. Wir sind Nachbarn von Las Merindades und verstehen die Bedürfnisse der Menschen und Unternehmen der Comarca besser als jeder externe Betreiber.' },
  ],
};

const currentReasons = reasons[lang];
---

<section class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-16 border-l-4 border-eco-600 pl-6">
      <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">{tr.sectionWhyLabel}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{tr.sectionWhyTitle}</h2>
      <p class="text-gray-500 text-lg max-w-3xl">{tr.sectionWhySubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px border border-gray-200">
      {currentReasons.map((reason, i) => (
        <div class="p-8 border-b border-r border-gray-200 hover:bg-gray-50 transition-colors duration-150">
          <div class="w-11 h-11 bg-eco-100 text-eco-700 flex items-center justify-center mb-5" set:html={reasonKeys[i].icon}/>
          <h3 class="font-bold text-gray-900 text-lg mb-3">{reason.title}</h3>
          <p class="text-gray-500 leading-relaxed text-sm">{reason.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 bg-eco-800 p-8 md:p-12">
      <div class="max-w-3xl">
        <div class="w-8 h-1 bg-eco-400 mb-6"></div>
        <p class="text-xl md:text-2xl text-eco-100 leading-relaxed mb-8 italic">{tr.whyQuote}</p>
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-eco-600 flex items-center justify-center font-extrabold text-white text-base">DG</div>
          <div>
            <p class="font-bold text-white text-base">Davinia Gómez Baranda</p>
            <p class="text-eco-400 text-sm">{tr.whyQuoteAuthor}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

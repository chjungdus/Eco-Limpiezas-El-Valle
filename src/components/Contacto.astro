---
---

<section id="contacto" class="py-20 md:py-28 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-block text-eco-600 font-semibold text-sm uppercase tracking-widest mb-3">Estamos disponibles</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Contáctanos</h2>
      <p class="text-lg text-gray-500 max-w-xl mx-auto">
        Pídenos presupuesto sin compromiso. Te respondemos rápido y nos adaptamos a tus horarios.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">

      <!-- Left: Contact card -->
      <div class="bg-eco-800 rounded-3xl p-8 md:p-10 text-white flex flex-col justify-between">
        <div>
          <!-- Person info -->
          <div class="flex items-center gap-4 mb-8">
            <div class="w-16 h-16 bg-eco-600 rounded-2xl flex items-center justify-center flex-shrink-0 text-2xl font-extrabold">
              DG
            </div>
            <div>
              <p class="font-bold text-xl text-white">Davinia Gómez Baranda</p>
              <p class="text-eco-300 text-sm mt-0.5">Responsable de Eco-Limpiezas El Valle</p>
            </div>
          </div>

          <!-- Phone (hero-size, tappable) -->
          <a
            href="tel:+34605984005"
            class="block group"
          >
            <div class="text-eco-300 text-sm font-medium mb-1 uppercase tracking-wider">Teléfono</div>
            <div class="text-4xl md:text-5xl font-extrabold text-white group-hover:text-eco-300 transition-colors duration-200 leading-none">
              605 984 005
            </div>
          </a>

          <div class="mt-6 space-y-3">
            <div class="flex items-center gap-3 text-eco-200 text-sm">
              <svg class="w-5 h-5 text-eco-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Atendemos en horario flexible, incluso fines de semana
            </div>
            <div class="flex items-center gap-3 text-eco-200 text-sm">
              <svg class="w-5 h-5 text-eco-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
              Espinosa de los Monteros y Las Merindades, Burgos
            </div>
            <div class="flex items-center gap-3 text-eco-200 text-sm">
              <svg class="w-5 h-5 text-eco-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              Presupuesto gratuito y sin compromiso
            </div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a
            href="tel:+34605984005"
            class="flex-1 flex items-center justify-center gap-2 bg-white text-eco-800 hover:bg-eco-50 px-6 py-3.5 rounded-xl font-bold transition-colors duration-200 text-sm"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Llamar ahora
          </a>
          <a
            href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n%20sobre%20vuestros%20servicios%20de%20limpieza"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20bd59] text-white px-6 py-3.5 rounded-xl font-bold transition-colors duration-200 text-sm"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Right: quick info cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 content-start">
        {[
          {
            icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
            title: 'Particulares',
            desc: 'Hogares, viviendas, pisos y casas particulares de cualquier tamaño.',
            color: 'bg-blue-50 text-blue-600',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
            title: 'Empresas',
            desc: 'Oficinas, locales comerciales, naves y todo tipo de espacios empresariales.',
            color: 'bg-eco-50 text-eco-600',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
            title: 'Presupuesto Gratis',
            desc: 'Solicita tu presupuesto personalizado sin coste y sin compromiso.',
            color: 'bg-yellow-50 text-yellow-600',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`,
            title: 'Calidad Garantizada',
            desc: 'Nos comprometemos con la calidad en cada servicio que realizamos.',
            color: 'bg-purple-50 text-purple-600',
          },
        ].map(card => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 ${card.color}`} set:html={card.icon}/>
            <h3 class="font-bold text-gray-900 mb-2">{card.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

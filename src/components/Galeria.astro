---
const photos = [
  { label: 'Limpieza doméstica', sub: 'Resultado antes/después' },
  { label: 'Fin de obra', sub: 'Limpieza post-construcción' },
  { label: 'Tapicería', sub: 'Sofá restaurado' },
  { label: 'Cristales', sub: 'Sin marcas ni rayas' },
  { label: 'Limpieza de oficina', sub: 'Espacio de trabajo' },
  { label: 'Equipo en acción', sub: 'Trabajando con cuidado' },
];
---

<section class="py-20 md:py-28 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <span class="inline-block text-eco-600 font-semibold text-sm uppercase tracking-widest mb-3">Nuestro trabajo</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Galería de Trabajos</h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        Imágenes reales de nuestros servicios. Cada trabajo refleja nuestra dedicación y el nivel de detalle que ponemos en cada limpieza.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {photos.map((photo, i) => (
        <div class={`group relative rounded-2xl overflow-hidden bg-gray-200 border-2 border-dashed border-gray-300 hover:border-eco-400 hover:bg-eco-50 transition-all duration-300 flex flex-col items-center justify-center cursor-pointer ${i === 0 ? 'sm:col-span-2 lg:col-span-1 aspect-[4/3]' : 'aspect-[4/3]'}`}>
          <svg class="w-12 h-12 text-gray-400 group-hover:text-eco-500 mb-3 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-gray-600 font-semibold group-hover:text-eco-700 transition-colors text-center px-4">{photo.label}</p>
          <p class="text-gray-400 text-sm mt-1 group-hover:text-eco-500 transition-colors text-center px-4">{photo.sub}</p>

          <!-- Overlay badge on hover -->
          <div class="absolute inset-0 bg-eco-600/0 group-hover:bg-eco-600/5 transition-colors duration-300 rounded-2xl"></div>
          <div class="absolute top-3 right-3 bg-white/0 group-hover:bg-white text-eco-600 text-xs font-bold px-3 py-1 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-sm">
            Añadir foto
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <p class="text-gray-400 text-sm italic">
        * Los espacios marcados se actualizarán con fotografías reales de los trabajos realizados.
      </p>
    </div>
  </div>
</section>

---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const langBase = lang === 'es' ? b : `${b}/${lang}`;

const items = {
  es: [
    { title: 'Limpieza doméstica', desc: 'Hogares, pisos y casas rurales con productos ecológicos.', img: 'habitacion-limpia.jpeg', icon: '🏠' },
    { title: 'Fin de obra', desc: 'Limpieza especializada tras reformas y construcciones.', img: 'makita-finobra.jpeg', icon: '🔨' },
    { title: 'Tapicerías', desc: 'Sofás, sillones y moquetas con maquinaria Kärcher profesional.', img: 'tapiceria-sofa.jpeg', icon: '🛋️' },
    { title: 'Cristales', desc: 'Interiores y exteriores sin rayas ni residuos.', img: 'cristales-puerta.jpeg', icon: '🪟' },
  ],
  en: [
    { title: 'Domestic cleaning', desc: 'Homes, flats and rural houses with eco-friendly products.', img: 'habitacion-limpia.jpeg', icon: '🏠' },
    { title: 'Post-construction', desc: 'Specialist cleaning after renovations and building work.', img: 'makita-finobra.jpeg', icon: '🔨' },
    { title: 'Upholstery', desc: 'Sofas, armchairs and carpets with professional Kärcher machinery.', img: 'tapiceria-sofa.jpeg', icon: '🛋️' },
    { title: 'Glass cleaning', desc: 'Interior and exterior glass, no streaks or residues.', img: 'cristales-puerta.jpeg', icon: '🪟' },
  ],
  de: [
    { title: 'Haushaltsreinigung', desc: 'Häuser, Wohnungen und Landhäuser mit Öko-Produkten.', img: 'habitacion-limpia.jpeg', icon: '🏠' },
    { title: 'Baureinigung', desc: 'Spezialisierte Reinigung nach Renovierungen und Bauprojekten.', img: 'makita-finobra.jpeg', icon: '🔨' },
    { title: 'Polsterreinigung', desc: 'Sofas, Sessel und Teppiche mit professioneller Kärcher-Maschine.', img: 'tapiceria-sofa.jpeg', icon: '🛋️' },
    { title: 'Glasreinigung', desc: 'Innen- und Außenverglasungen ohne Streifen oder Rückstände.', img: 'cristales-puerta.jpeg', icon: '🪟' },
  ],
};

const labels = {
  es: { badge: 'Nuestros servicios', heading: 'Lo que hacemos', more: 'Ver todos los servicios' },
  en: { badge: 'Our services', heading: 'What we do', more: 'See all services' },
  de: { badge: 'Unsere Dienste', heading: 'Was wir tun', more: 'Alle Dienste ansehen' },
};

const currentItems = items[lang];
const l = labels[lang];
---

<section class="py-20 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">{l.badge}</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900">{l.heading}</h2>
      </div>
      <a href={`${langBase}/servicios/`}
        class="flex items-center gap-2 text-eco-700 font-semibold text-sm hover:text-eco-900 transition-colors whitespace-nowrap">
        {l.more}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentItems.map(item => (
        <a href={`${langBase}/servicios/`}
          class="group block border border-gray-200 hover:border-eco-400 transition-colors duration-150 overflow-hidden">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={`${base}/images/${item.img}`}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-5">
            <h3 class="font-bold text-gray-900 text-base mb-1 group-hover:text-eco-700 transition-colors">{item.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

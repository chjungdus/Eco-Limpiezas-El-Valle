---
import type { Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const langBase = lang === 'es' ? b : `${b}/${lang}`;

const cta = {
  es: 'Más información',
  en: 'Learn more',
  de: 'Mehr erfahren',
};

const sections = {
  es: [
    {
      slug: 'servicios',
      title: 'Nuestros Servicios',
      desc: 'Limpieza doméstica, fin de obra, tapicerías y cristales. Servicio profesional para particulares y empresas en toda la comarca de Las Merindades.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
      tags: ['Doméstica', 'Fin de obra', 'Tapicerías', 'Cristales'],
    },
    {
      slug: 'nosotros',
      title: 'Quiénes Somos',
      desc: 'Empresa local con sede en Espinosa de los Monteros. Davinia Gómez Baranda al frente de cada servicio, con atención directa y personal en todo momento.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
      tags: ['Empresa local', 'Atención directa', 'Confianza', 'Experiencia'],
    },
    {
      slug: 'referencias',
      title: 'Referencias',
      desc: 'Trabajamos para viviendas, oficinas, comunidades de vecinos, establecimientos hosteleros, locales comerciales y obras en toda la comarca.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
      tags: ['Viviendas', 'Oficinas', 'Hostelería', 'Comunidades'],
    },
    {
      slug: 'zona',
      title: 'Zona de Trabajo',
      desc: 'Cubrimos Espinosa de los Monteros y toda la comarca de Las Merindades, Burgos. También valoramos servicios en zonas limítrofes con Cantabria, Vizcaya y Álava.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
      tags: ['Espinosa', 'Las Merindades', 'Villarcayo', 'Medina de Pomar'],
    },
    {
      slug: 'contacto',
      title: 'Contacto',
      desc: 'Llámanos o escríbenos por WhatsApp. Respondemos rápido y elaboramos tu presupuesto de forma gratuita y sin ningún compromiso.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
      tags: ['Teléfono', 'WhatsApp', 'Presupuesto gratis', 'Respuesta rápida'],
    },
  ],
  en: [
    {
      slug: 'servicios',
      title: 'Our Services',
      desc: 'Domestic cleaning, post-construction, upholstery and glass. Professional service for private clients and businesses throughout Las Merindades.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
      tags: ['Domestic', 'Post-construction', 'Upholstery', 'Glass'],
    },
    {
      slug: 'nosotros',
      title: 'About Us',
      desc: 'Local company based in Espinosa de los Monteros. Davinia Gómez Baranda leads every service, with direct personal attention at all times.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
      tags: ['Local business', 'Direct attention', 'Trust', 'Experience'],
    },
    {
      slug: 'referencias',
      title: 'References',
      desc: 'We work for homes, offices, residents\' associations, hospitality businesses, commercial premises and post-construction throughout the comarca.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
      tags: ['Homes', 'Offices', 'Hospitality', 'Communities'],
    },
    {
      slug: 'zona',
      title: 'Service Area',
      desc: 'We cover Espinosa de los Monteros and the entire comarca of Las Merindades, Burgos. We also consider services in bordering areas of Cantabria, Biscay and Álava.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
      tags: ['Espinosa', 'Las Merindades', 'Villarcayo', 'Medina de Pomar'],
    },
    {
      slug: 'contacto',
      title: 'Contact',
      desc: 'Call us or message us on WhatsApp. We respond quickly and prepare your quote free of charge and with no obligation.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
      tags: ['Phone', 'WhatsApp', 'Free quote', 'Fast response'],
    },
  ],
  de: [
    {
      slug: 'servicios',
      title: 'Unsere Leistungen',
      desc: 'Haushaltsreinigung, Baureinigung, Polsterreinigung und Glasreinigung. Professioneller Service für Privat- und Geschäftskunden in der gesamten Comarca Las Merindades.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
      tags: ['Haushalt', 'Baureinigung', 'Polster', 'Glas'],
    },
    {
      slug: 'nosotros',
      title: 'Über Uns',
      desc: 'Lokales Unternehmen mit Sitz in Espinosa de los Monteros. Davinia Gómez Baranda leitet jeden Auftrag persönlich – direkte Betreuung zu jeder Zeit.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
      tags: ['Lokal', 'Direkt', 'Vertrauen', 'Erfahrung'],
    },
    {
      slug: 'referencias',
      title: 'Referenzen',
      desc: 'Wir reinigen Wohnungen, Büros, Wohnungseigentümergemeinschaften, Gastronomiebetriebe, Gewerbeflächen und Bauprojekte in der gesamten Comarca.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
      tags: ['Wohnungen', 'Büros', 'Gastronomie', 'Gemeinschaften'],
    },
    {
      slug: 'zona',
      title: 'Einsatzgebiet',
      desc: 'Wir decken Espinosa de los Monteros und die gesamte Comarca Las Merindades, Burgos ab. Auch angrenzende Gebiete in Kantabrien, Biskaya und Álava auf Anfrage.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
      tags: ['Espinosa', 'Las Merindades', 'Villarcayo', 'Medina de Pomar'],
    },
    {
      slug: 'contacto',
      title: 'Kontakt',
      desc: 'Rufen Sie uns an oder schreiben Sie uns per WhatsApp. Wir antworten schnell und erstellen Ihr Angebot kostenlos und unverbindlich.',
      icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
      tags: ['Telefon', 'WhatsApp', 'Kostenloses Angebot', 'Schnelle Antwort'],
    },
  ],
};

const ctaLabel = cta[lang];
const currentSections = sections[lang];
---

<section class="py-20 md:py-28 bg-gray-50 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-14 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">
        {lang === 'es' && 'Todo lo que necesitas saber'}
        {lang === 'en' && 'Everything you need to know'}
        {lang === 'de' && 'Alles, was Sie wissen müssen'}
      </h2>
      <p class="text-gray-500 text-lg max-w-xl mx-auto">
        {lang === 'es' && 'Explora cada sección para conocer en detalle lo que ofrecemos.'}
        {lang === 'en' && 'Explore each section to find out in detail what we offer.'}
        {lang === 'de' && 'Erkunden Sie jeden Bereich, um zu erfahren, was wir im Detail anbieten.'}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {currentSections.map(section => (
        <a href={`${langBase}/${section.slug}/`}
          class="group bg-white border border-gray-200 hover:border-eco-500 hover:shadow-md transition-all duration-200 flex flex-col">
          <div class="p-7 flex-1">
            <div class="w-12 h-12 bg-eco-100 text-eco-700 flex items-center justify-center mb-5 group-hover:bg-eco-700 group-hover:text-white transition-colors duration-200" set:html={section.icon} />
            <h3 class="font-bold text-gray-900 text-xl mb-3 group-hover:text-eco-700 transition-colors">{section.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-5">{section.desc}</p>
            <div class="flex flex-wrap gap-2">
              {section.tags.map(tag => (
                <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 font-medium">{tag}</span>
              ))}
            </div>
          </div>
          <div class="border-t border-gray-100 px-7 py-4 flex items-center justify-between">
            <span class="text-eco-700 font-semibold text-sm group-hover:text-eco-900 transition-colors">{ctaLabel}</span>
            <svg class="w-4 h-4 text-eco-600 group-hover:translate-x-1 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

---
const sectors = [
  {
    title: 'Viviendas Particulares',
    description: 'Hogares unifamiliares, pisos, apartamentos y casas rurales. Servicio de limpieza regular o puntual, adaptado al tamaño y las necesidades concretas de cada vivienda. Discreción y confianza garantizadas.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  },
  {
    title: 'Oficinas y Despachos',
    description: 'Espacios de trabajo de cualquier tamaño: despachos profesionales, oficinas corporativas, consultas y estudios. Trabajamos fuera del horario laboral para no interferir con la actividad diaria.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  },
  {
    title: 'Establecimientos Hosteleros',
    description: 'Hoteles, hostales, casas rurales, restaurantes y bares. La higiene es fundamental en este sector. Ofrecemos servicios de limpieza diarios, semanales o por temporada, con la fiabilidad que el negocio hostelero exige.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>`,
  },
  {
    title: 'Locales Comerciales',
    description: 'Tiendas, comercios, supermercados, farmacias y cualquier tipo de establecimiento comercial. Mantenemos los espacios de venta en las mejores condiciones de limpieza e imagen para sus clientes.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>`,
  },
  {
    title: 'Comunidades de Vecinos',
    description: 'Zonas comunes de edificios residenciales: portales, escaleras, ascensores, garajes, trasteros y jardines. Servicio regular y documentado para garantizar el cumplimiento de los estándares de higiene.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
  {
    title: 'Obras y Reformas',
    description: 'Limpieza especializada tras obras de construcción, reformas y rehabilitaciones. Eliminamos el polvo de obra, los restos de materiales y dejamos el espacio listo para su uso o entrega.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
];
---

<section id="referencias" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-16 border-l-4 border-eco-600 pl-6">
      <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">A quién atendemos</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Sectores de Actividad</h2>
      <p class="text-gray-500 text-lg max-w-3xl">
        Prestamos servicios de limpieza a una amplia variedad de clientes, tanto particulares como empresas y organismos. Cada sector tiene sus necesidades específicas y nos adaptamos a todas ellas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-200">
      {sectors.map(sector => (
        <div class="bg-white p-8 hover:bg-gray-50 transition-colors duration-150">
          <div class="text-eco-700 mb-5" set:html={sector.icon}/>
          <h3 class="font-bold text-gray-900 text-lg mb-3">{sector.title}</h3>
          <p class="text-gray-500 leading-relaxed text-sm">{sector.description}</p>
        </div>
      ))}
    </div>

    <!-- Photo slots: client gallery -->
    <div class="mt-16">
      <h3 class="font-bold text-gray-900 text-xl mb-8 pb-4 border-b border-gray-200">Algunos de nuestros trabajos</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {['Limpieza doméstica', 'Fin de obra', 'Tapicería', 'Cristales', 'Oficina', 'Hostelería', 'Comunidad', 'Local comercial'].map(label => (
          <div class="aspect-square bg-gray-100 border border-dashed border-gray-300 hover:border-eco-400 hover:bg-eco-50 transition-colors duration-200 flex flex-col items-center justify-center group">
            <svg class="w-8 h-8 text-gray-400 group-hover:text-eco-500 mb-2 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <p class="text-gray-500 text-xs text-center px-2 group-hover:text-eco-700 transition-colors font-medium">{label}</p>
          </div>
        ))}
      </div>
      <p class="text-gray-400 text-sm mt-4 italic">* Los espacios se actualizarán con fotografías reales de trabajos realizados.</p>
    </div>

  </div>
</section>

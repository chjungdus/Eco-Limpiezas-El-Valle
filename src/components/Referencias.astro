---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);

const sectorIcons = [
  `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>`,
  `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>`,
  `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
];

const sectors = {
  es: [
    { title: 'Viviendas Particulares', description: 'Hogares unifamiliares, pisos, apartamentos y casas rurales. Servicio de limpieza regular o puntual, adaptado al tamaño y las necesidades concretas de cada vivienda. Discreción y confianza garantizadas.' },
    { title: 'Oficinas y Despachos', description: 'Espacios de trabajo de cualquier tamaño: despachos profesionales, oficinas corporativas, consultas y estudios. Trabajamos fuera del horario laboral para no interferir con la actividad diaria.' },
    { title: 'Establecimientos Hosteleros', description: 'Hoteles, hostales, casas rurales, restaurantes y bares. La higiene es fundamental en este sector. Ofrecemos servicios de limpieza diarios, semanales o por temporada, con la fiabilidad que el negocio hostelero exige.' },
    { title: 'Locales Comerciales', description: 'Tiendas, comercios, supermercados, farmacias y cualquier tipo de establecimiento comercial. Mantenemos los espacios de venta en las mejores condiciones de limpieza e imagen para sus clientes.' },
    { title: 'Comunidades de Vecinos', description: 'Zonas comunes de edificios residenciales: portales, escaleras, ascensores, garajes, trasteros y jardines. Servicio regular y documentado para garantizar el cumplimiento de los estándares de higiene.' },
    { title: 'Obras y Reformas', description: 'Limpieza especializada tras obras de construcción, reformas y rehabilitaciones. Eliminamos el polvo de obra, los restos de materiales y dejamos el espacio listo para su uso o entrega.' },
  ],
  en: [
    { title: 'Private Homes', description: 'Detached houses, flats, apartments and rural properties. Regular or one-off cleaning service, adapted to the size and specific needs of each home. Discretion and trust guaranteed.' },
    { title: 'Offices and Workspaces', description: 'Workspaces of any size: professional offices, corporate offices, consulting rooms and studios. We work outside business hours to avoid interfering with daily activity.' },
    { title: 'Hospitality Establishments', description: 'Hotels, hostels, rural guesthouses, restaurants and bars. Hygiene is fundamental in this sector. We offer daily, weekly or seasonal cleaning services with the reliability that hospitality businesses require.' },
    { title: 'Commercial Premises', description: 'Shops, supermarkets, pharmacies and all types of commercial establishments. We keep sales areas in the best possible condition for your customers.' },
    { title: "Residents' Associations", description: 'Common areas of residential buildings: entrance halls, staircases, lifts, garages, storage rooms and gardens. Regular, documented service to ensure compliance with hygiene standards.' },
    { title: 'Construction and Renovation', description: 'Specialist cleaning after construction work, renovations and refurbishments. We remove construction dust and material residues and leave the space ready for use or handover.' },
  ],
  de: [
    { title: 'Privatwohnungen', description: 'Einfamilienhäuser, Wohnungen, Appartements und Landhäuser. Regelmäßiger oder einmaliger Reinigungsservice, angepasst an Größe und konkrete Bedürfnisse jeder Unterkunft. Diskretion und Vertrauen garantiert.' },
    { title: 'Büros und Arbeitsräume', description: 'Arbeitsbereiche jeder Größe: professionelle Büros, Unternehmensbüros, Praxen und Studios. Wir arbeiten außerhalb der Geschäftszeiten, um den Tagesbetrieb nicht zu stören.' },
    { title: 'Gastronomiebetriebe', description: 'Hotels, Pensionen, Landgasthöfe, Restaurants und Bars. Hygiene ist in diesem Bereich grundlegend. Wir bieten tägliche, wöchentliche oder saisonale Reinigungsdienste mit der Zuverlässigkeit, die Gastronomiebetriebe benötigen.' },
    { title: 'Gewerbeflächen', description: 'Geschäfte, Supermärkte, Apotheken und alle Arten von Gewerbebetrieben. Wir halten die Verkaufsflächen in bestem Zustand für Ihre Kunden.' },
    { title: 'Wohnungseigentümergemeinschaften', description: 'Gemeinschaftsbereiche von Wohngebäuden: Eingangshallen, Treppenhäuser, Aufzüge, Garagen, Abstellräume und Gärten. Regelmäßiger, dokumentierter Service zur Einhaltung der Hygienestandards.' },
    { title: 'Bau und Renovierung', description: 'Spezialisierte Reinigung nach Bau-, Renovierungs- und Sanierungsarbeiten. Wir entfernen Baustaub und Materialreste und hinterlassen den Raum bezugsfertig.' },
  ],
};

const photoLabels = {
  es: ['Limpieza doméstica', 'Fin de obra', 'Tapicería', 'Cristales', 'Oficina', 'Hostelería', 'Comunidad', 'Local comercial'],
  en: ['Domestic cleaning', 'Post-construction', 'Upholstery', 'Glass cleaning', 'Office', 'Hospitality', 'Community areas', 'Commercial premises'],
  de: ['Haushaltsreinigung', 'Baureinigung', 'Polsterreinigung', 'Glasreinigung', 'Büro', 'Gastronomie', 'Gemeinschaftsbereiche', 'Gewerbelokal'],
};

const currentSectors = sectors[lang];
const currentLabels = photoLabels[lang];
const base = import.meta.env.BASE_URL;

const refPhotoSrcs = [
  'habitacion-limpia.jpeg',
  'escalera.jpeg',
  'tapiceria-karcher.jpeg',
  'cristales-escobilla.jpeg',
  'cocina-rural-ladrillo.jpeg',
  'cocina-rural-suelo.jpeg',
  'garaje.jpeg',
  'van-logo.jpeg',
];
---

<section id="referencias" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-16 border-l-4 border-eco-600 pl-6">
      <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">{tr.sectionRefLabel}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{tr.sectionRefTitle}</h2>
      <p class="text-gray-500 text-lg max-w-3xl">{tr.sectionRefSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-200">
      {currentSectors.map((sector, i) => (
        <div class="bg-white p-8 hover:bg-gray-50 transition-colors duration-150">
          <div class="text-eco-700 mb-5" set:html={sectorIcons[i]}/>
          <h3 class="font-bold text-gray-900 text-lg mb-3">{sector.title}</h3>
          <p class="text-gray-500 leading-relaxed text-sm">{sector.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-16">
      <h3 class="font-bold text-gray-900 text-xl mb-8 pb-4 border-b border-gray-200">{tr.refWorksTitle}</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {currentLabels.map((label, i) => (
          <div class="group relative aspect-square overflow-hidden">
            <img
              src={`${base}images/${refPhotoSrcs[i]}`}
              alt={label}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <p class="text-white font-semibold text-sm text-center px-3">{label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

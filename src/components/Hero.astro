---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
---

<section class="relative bg-eco-900 text-white overflow-hidden">
  <div class="absolute inset-0 opacity-5 pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full" viewBox="0 0 60 60" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="hero-grid" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M 60 0 L 0 0 0 60" fill="none" stroke="white" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)"/>
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 lg:py-36">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <div class="inline-block bg-eco-700 text-eco-100 text-xs font-semibold px-4 py-1.5 mb-8 uppercase tracking-widest">
          {tr.heroBadge}
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
          {lang === 'es' && <>Limpieza profesional<br/>en <span class="text-eco-400">Espinosa de los Monteros</span><br/>y Las Merindades</>}
          {lang === 'en' && <>Professional cleaning<br/>in <span class="text-eco-400">Espinosa de los Monteros</span><br/>and Las Merindades</>}
          {lang === 'de' && <>Professionelle Reinigung<br/>in <span class="text-eco-400">Espinosa de los Monteros</span><br/>und Las Merindades</>}
        </h1>
        <p class="text-eco-200 text-lg leading-relaxed mb-4">{tr.heroText1}</p>
        <p class="text-eco-300 leading-relaxed mb-10">{tr.heroText2}</p>

        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="tel:+34605984005"
            class="inline-flex items-center justify-center gap-3 bg-white text-eco-900 hover:bg-eco-50 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {tr.heroCta1}
          </a>
          <a href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n%20sobre%20vuestros%20servicios%20de%20limpieza"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 border border-eco-500 text-eco-200 hover:bg-eco-800 px-8 py-4 font-bold text-base transition-colors duration-150">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {tr.heroCta2}
          </a>
        </div>

        <div class="grid grid-cols-2 gap-4 pt-8 border-t border-eco-700">
          {[tr.heroTrust1, tr.heroTrust2, tr.heroTrust3, tr.heroTrust4].map(item => (
            <div class="flex items-start gap-2 text-eco-300 text-sm">
              <svg class="w-4 h-4 text-eco-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile photo -->
      <div class="block lg:hidden w-full">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/sede-mobile.jpeg`}
          alt="Sede Limpiezas El Valle, Espinosa de los Monteros"
          class="w-full object-cover max-h-64"
        />
      </div>

      <!-- Desktop photos -->
      <div class="hidden lg:flex flex-col gap-4">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/van-logo.jpeg`}
          alt="Vehículo profesional Limpiezas El Valle con servicios"
          class="w-full aspect-[3/2] object-cover"
        />
        <div class="grid grid-cols-2 gap-4">
          <img
            src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/cocina-rural-ladrillo.jpeg`}
            alt="Cocina rural limpia - trabajo de calidad"
            class="aspect-video object-cover w-full"
          />
          <img
            src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/karcher-exterior.jpeg`}
            alt="Maquinaria profesional Kärcher para tapicerías"
            class="aspect-video object-cover w-full"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Stats bar -->
  <div class="bg-eco-950 border-t border-eco-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-eco-800">
        {[
          { value: '100%', label: tr.statSatisfaction },
          { value: '+50', label: tr.statClients },
          { value: '7/7', label: tr.statDays },
          { value: '★★★', label: tr.statEco },
        ].map(stat => (
          <div class="px-8 py-6 text-center">
            <div class="text-3xl font-extrabold text-eco-400 mb-1">{stat.value}</div>
            <div class="text-eco-400 text-xs uppercase tracking-widest">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);

const steps = {
  es: [
    { number: '01', title: 'Primera consulta', desc: 'Ponte en contacto con nosotros por teléfono o WhatsApp. Cuéntanos qué tipo de limpieza necesitas, las características del espacio, cuándo y con qué frecuencia. No hace falta que tengas todos los detalles: nosotros te orientamos desde el primer momento.' },
    { number: '02', title: 'Valoración y presupuesto', desc: 'A partir de la información que nos facilitas, elaboramos un presupuesto detallado, claro y sin compromisos. Si es necesario, podemos realizar una visita previa al espacio. El presupuesto es siempre gratuito.' },
    { number: '03', title: 'Acuerdo de fecha y condiciones', desc: 'Una vez aceptado el presupuesto, acordamos juntos la fecha, el horario y las condiciones del servicio. Tú eliges el momento que te resulte más cómodo. Si se trata de un servicio recurrente, establecemos un calendario adaptado.' },
    { number: '04', title: 'Ejecución del trabajo', desc: 'Llegamos puntualmente, trabajamos con eficacia y maquinaria profesional. Al terminar, realizamos una revisión del resultado antes de dar el trabajo por concluido.' },
  ],
  en: [
    { number: '01', title: 'First contact', desc: 'Get in touch by phone or WhatsApp. Tell us what type of cleaning you need, the characteristics of the space, when and how often. You do not need to have all the details: we will guide you from the outset.' },
    { number: '02', title: 'Assessment and quote', desc: 'Based on the information you provide, we prepare a detailed, clear and commitment-free quote. If necessary, we can arrange a prior visit. The quote is always free of charge.' },
    { number: '03', title: 'Date and conditions agreed', desc: 'Once the quote is accepted, we agree together on the date, time and conditions of the service. You choose the most convenient time. For recurring services, we set up a schedule adapted to your needs.' },
    { number: '04', title: 'Work carried out', desc: 'We arrive punctually and work efficiently with professional machinery. On completion, we carry out a final review before considering the job finished.' },
  ],
  de: [
    { number: '01', title: 'Erstkontakt', desc: 'Kontaktieren Sie uns per Telefon oder WhatsApp. Teilen Sie uns mit, welche Art von Reinigung Sie benötigen, die Eigenschaften des Raums, wann und wie häufig. Sie müssen nicht alle Details kennen: Wir beraten Sie von Anfang an.' },
    { number: '02', title: 'Bewertung und Angebot', desc: 'Anhand der von Ihnen bereitgestellten Informationen erstellen wir ein detailliertes, klares und unverbindliches Angebot. Bei Bedarf können wir einen Vorbesuch durchführen. Das Angebot ist stets kostenlos.' },
    { number: '03', title: 'Termin und Bedingungen vereinbart', desc: 'Nach Annahme des Angebots vereinbaren wir gemeinsam Datum, Uhrzeit und Bedingungen des Dienstes. Sie wählen den bequemsten Zeitpunkt. Bei regelmäßigen Diensten erstellen wir einen angepassten Zeitplan.' },
    { number: '04', title: 'Ausführung der Arbeit', desc: 'Wir kommen pünktlich und arbeiten effizient mit professionellen Maschinen. Nach Abschluss führen wir eine abschließende Überprüfung durch, bevor wir den Auftrag als erledigt betrachten.' },
  ],
};
---

<section class="py-20 md:py-28 bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 border-l-4 border-eco-500 pl-6">
      <span class="text-eco-400 font-semibold text-sm uppercase tracking-widest block mb-2">{tr.sectionHowLabel}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">{tr.sectionHowTitle}</h2>
      <p class="text-gray-400 text-lg max-w-3xl">{tr.sectionHowSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-gray-700">
      {steps[lang].map(step => (
        <div class="bg-gray-900 p-8 hover:bg-gray-800 transition-colors duration-150">
          <div class="text-5xl font-extrabold text-eco-800 mb-6 leading-none select-none">{step.number}</div>
          <h3 class="font-bold text-white text-lg mb-4">{step.title}</h3>
          <p class="text-gray-400 leading-relaxed text-sm">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col sm:flex-row gap-4 justify-center">
      <a href="tel:+34605984005"
        class="inline-flex items-center justify-center gap-3 bg-white text-gray-900 hover:bg-gray-100 px-8 py-4 font-bold text-sm transition-colors duration-150">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        {tr.howCallBtn}
      </a>
      <a href="https://wa.me/34605984005?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20informaci%C3%B3n%20sobre%20vuestros%20servicios%20de%20limpieza"
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20bd59] text-white px-8 py-4 font-bold text-sm transition-colors duration-150">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {tr.howWhatsappBtn}
      </a>
    </div>
  </div>
</section>

---
const municipios = [
  'Espinosa de los Monteros',
  'Villarcayo',
  'Medina de Pomar',
  'Trespaderne',
  'Merindad de Río Ubierna',
  'Valle de Mena',
  'Berberana',
  'Merindad de Cuesta Urria',
  'Merindad de Sotoscueva',
  'Y más municipios de Las Merindades',
];
---

<section id="zona" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Left: text -->
      <div>
        <span class="inline-block text-eco-600 font-semibold text-sm uppercase tracking-widest mb-3">Dónde trabajamos</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-6">Zona de Trabajo</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          Prestamos servicio en <strong class="text-gray-900">Espinosa de los Monteros</strong> y toda la comarca de <strong class="text-gray-900">Las Merindades</strong>, en la provincia de Burgos.
        </p>
        <p class="text-gray-500 leading-relaxed mb-8">
          ¿No sabes si llegamos a tu zona? Llámanos o escríbenos por WhatsApp — lo comprobamos de inmediato y te damos respuesta enseguida.
        </p>

        <!-- Municipality list -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-8">
          {municipios.map(m => (
            <div class="flex items-center gap-2 text-gray-600 text-sm">
              <svg class="w-4 h-4 text-eco-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
              {m}
            </div>
          ))}
        </div>

        <a
          href="tel:+34605984005"
          class="inline-flex items-center gap-2 bg-eco-600 hover:bg-eco-700 text-white px-7 py-3.5 rounded-xl font-bold transition-colors duration-200 shadow-sm"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Consultar mi zona
        </a>
      </div>

      <!-- Right: map card -->
      <div class="relative">
        <div class="bg-eco-50 rounded-3xl p-8 border border-eco-100">
          <!-- Stylized map with SVG -->
          <div class="aspect-square max-w-sm mx-auto relative">
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
              <div class="bg-eco-600 text-white rounded-2xl px-6 py-4 shadow-xl mb-4">
                <div class="text-2xl font-extrabold">Las Merindades</div>
                <div class="text-eco-200 text-sm mt-1">Burgos, Castilla y León</div>
              </div>
              <div class="bg-white rounded-xl px-4 py-3 shadow-md border border-eco-100">
                <div class="flex items-center gap-2 text-eco-700">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="font-semibold text-sm">Espinosa de los Monteros</span>
                </div>
              </div>
            </div>
            <!-- Decorative circles -->
            <div class="absolute top-4 left-4 w-20 h-20 bg-eco-200 rounded-full opacity-30"></div>
            <div class="absolute bottom-4 right-4 w-32 h-32 bg-eco-300 rounded-full opacity-20"></div>
            <div class="absolute top-1/3 right-8 w-12 h-12 bg-eco-400 rounded-full opacity-25"></div>
            <div class="absolute bottom-1/3 left-8 w-16 h-16 bg-eco-100 rounded-full opacity-40 border-2 border-eco-300"></div>
          </div>

          <div class="mt-6 text-center">
            <p class="text-eco-700 font-medium text-sm">
              Atendemos toda la comarca de Las Merindades y alrededores
            </p>
            <p class="text-eco-500 text-xs mt-1">¿Tienes dudas? ¡Llámanos!</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);

const municipioNotes = {
  es: { main: 'Sede principal', capital: 'Capital comarcal', consult: 'Consultar disponibilidad', border: 'Municipios limítrofes' },
  en: { main: 'Main office', capital: 'Comarca capital', consult: 'Check availability', border: 'Neighbouring municipalities' },
  de: { main: 'Hauptsitz', capital: 'Comarca-Hauptort', consult: 'Verfügbarkeit prüfen', border: 'Angrenzende Gemeinden' },
};

const notes = municipioNotes[lang];

const municipios = [
  { name: 'Espinosa de los Monteros', note: notes.main },
  { name: 'Villarcayo', note: notes.capital },
  { name: 'Medina de Pomar', note: '' },
  { name: 'Trespaderne', note: '' },
  { name: 'Valle de Mena', note: '' },
  { name: 'Merindad de Sotoscueva', note: '' },
  { name: 'Merindad de Cuesta Urria', note: '' },
  { name: 'Merindad de Río Ubierna', note: '' },
  { name: 'Berberana', note: '' },
  { name: 'Merindad de Montija', note: '' },
  { name: 'Alfoz de Santa Gadea', note: '' },
  { name: notes.border, note: notes.consult },
];
---

<section id="zona" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="border-l-4 border-eco-600 pl-6 mb-16">
      <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">{tr.sectionZoneLabel}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{tr.sectionZoneTitle}</h2>
      <p class="text-gray-500 text-lg max-w-3xl">{tr.sectionZoneSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      <div>
        <p class="text-gray-700 text-lg leading-relaxed mb-6">{tr.zoneText1}</p>
        <p class="text-gray-600 leading-relaxed mb-6">{tr.zoneText2}</p>
        <p class="text-gray-600 leading-relaxed mb-10">{tr.zoneText3}</p>

        <div class="border border-gray-200 divide-y divide-gray-100">
          {municipios.map(m => (
            <div class="flex items-center justify-between px-5 py-3 hover:bg-gray-50 transition-colors duration-150">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-eco-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-800 font-medium text-sm">{m.name}</span>
              </div>
              {m.note && <span class="text-eco-700 text-xs font-semibold bg-eco-50 border border-eco-200 px-2 py-0.5">{m.note}</span>}
            </div>
          ))}
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href="tel:+34605984005"
            class="inline-flex items-center justify-center gap-2 bg-eco-700 hover:bg-eco-800 text-white px-7 py-3.5 font-bold text-sm transition-colors duration-150">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            {tr.zoneCallBtn}
          </a>
          <a href="https://wa.me/34605984005?text=Hola%2C%20quer%C3%ADa%20saber%20si%20cubr%C3%ADs%20mi%20zona"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-gray-300 hover:border-eco-500 text-gray-700 hover:text-eco-700 px-7 py-3.5 font-bold text-sm transition-colors duration-150">
            {tr.zoneWhatsappBtn}
          </a>
        </div>
      </div>

      <div class="space-y-6">
        <div class="w-full aspect-video bg-gray-100 border border-dashed border-gray-300 hover:border-eco-400 hover:bg-eco-50 transition-colors duration-200 flex flex-col items-center justify-center group">
          <svg class="w-12 h-12 text-gray-400 group-hover:text-eco-500 mb-3 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-gray-500 font-medium group-hover:text-eco-700 transition-colors">{tr.zonePhotoLabel}</p>
          <p class="text-gray-400 text-sm mt-1">{tr.zonePhotoSub}</p>
        </div>

        <div class="bg-eco-800 p-6 text-white">
          <div class="flex items-start gap-4">
            <svg class="w-6 h-6 text-eco-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            <div>
              <p class="font-bold text-white text-lg">{tr.zoneHqTitle}</p>
              <p class="text-eco-300 text-sm mt-1 leading-relaxed">{tr.zoneHqText}</p>
            </div>
          </div>
        </div>

        <div class="border border-gray-200 p-6">
          <p class="font-bold text-gray-900 mb-2">{tr.zoneOutsideTitle}</p>
          <p class="text-gray-500 text-sm leading-relaxed">{tr.zoneOutsideText}</p>
        </div>
      </div>
    </div>
  </div>
</section>

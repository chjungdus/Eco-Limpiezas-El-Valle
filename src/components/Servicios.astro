  es: 'Desplazamiento fuera de Espinosa de los Monteros: 1 € / km',
  en: 'Travel outside Espinosa de los Monteros: 1 € / km',
  de: 'Anfahrt außerhalb Espinosa de los Monteros: 1 € / km',
};
const consultLabel = { es: 'Consultar', en: 'On request', de: 'Auf Anfrage' };

const serviceLinks: Record<Lang, { tapiceria: string; finObra: string }> = {
  es: { tapiceria: `${base}/tapiceria/`, finObra: `${base}/fin-de-obra/` },
  en: { tapiceria: `${base}/en/tapiceria/`, finObra: `${base}/en/fin-de-obra/` },
  de: { tapiceria: `${base}/de/tapiceria/`, finObra: `${base}/de/fin-de-obra/` },

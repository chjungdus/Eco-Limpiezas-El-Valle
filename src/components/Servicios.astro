const currentServices = services[lang];
---

<section id="servicios" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-16 border-l-4 border-eco-600 pl-6">
      <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">{tr.sectionServicesLabel}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{tr.sectionServicesTitle}</h2>
      <p class="text-gray-500 text-lg max-w-3xl">{tr.sectionServicesSubtitle}</p>
    </div>

    <div class="divide-y divide-gray-100">
      {currentServices.map((service, i) => (
        <div class="grid grid-cols-1 lg:grid-cols-2">
          <div class={`${i % 2 === 1 ? 'lg:order-2' : ''} min-h-64 overflow-hidden`}>
            <img
              src={`${base}/images/${service.img}`}
              alt={service.title}
              class="w-full h-full object-cover min-h-64"
            />
          </div>
          <div class={`${i % 2 === 1 ? 'lg:order-1' : ''} p-8 md:p-10 flex flex-col justify-center`}>
            <div class={`inline-flex w-11 h-11 items-center justify-center mb-4 text-white ${service.color}`} set:html={service.icon}/>
            <h3 class="text-xl font-extrabold text-gray-900 mb-3">{service.title}</h3>
            <p class="text-gray-500 leading-relaxed mb-5 text-sm">{service.description}</p>
            <ul class="space-y-1.5 mb-6">
              {service.items.map(item => (
                <li class="flex items-start gap-2 text-gray-600 text-sm">
                  <svg class="w-3.5 h-3.5 text-eco-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>

            <!-- Prices -->
            <div class="border border-gray-200 bg-gray-50 mb-6">
              <div class="px-4 py-2 bg-gray-100 border-b border-gray-200">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">{priceLabel[lang]}</span>
              </div>
              {service.prices.map(p => (
                <div class="flex items-center justify-between px-4 py-2.5 border-b border-gray-100 last:border-0">
                  <span class="text-sm text-gray-700">{p.item}</span>
                  <span class="text-sm font-bold text-eco-700 ml-4 whitespace-nowrap">{p.price}</span>
                </div>
              ))}
            </div>

            <a href="tel:+34605984005"
              class="inline-flex items-center gap-2 bg-eco-700 hover:bg-eco-800 text-white px-5 py-2.5 font-semibold text-sm transition-colors duration-150 w-fit">
              {tr.servicesCta}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <p class="text-gray-400 text-xs mt-8 border-t border-gray-100 pt-6">{travelLabel[lang]}</p>

  </div>
</section>

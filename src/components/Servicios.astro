---
const services = [
  {
    title: 'Limpiezas Domésticas',
    description: 'Mantenemos tu hogar impecable con total discreción y productos respetuosos con el medioambiente. Servicio regular o puntual según tus necesidades.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
    color: 'bg-blue-50 text-blue-600',
  },
  {
    title: 'Limpieza de Fin de Obra',
    description: 'Eliminamos el polvo, los restos de materiales y la suciedad de construcción para que tu nuevo espacio esté listo para estrenar desde el primer día.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    color: 'bg-orange-50 text-orange-600',
  },
  {
    title: 'Tapicerías en General',
    description: 'Limpieza profunda y especializada de sofás, sillas, colchones, cortinas y todo tipo de tapizados. Devolvemos el aspecto original a tus tejidos.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
    color: 'bg-purple-50 text-purple-600',
  },
  {
    title: 'Limpieza de Cristales',
    description: 'Cristales interiores y exteriores sin marcas ni rayas, en hogares, oficinas y locales comerciales. Resultado perfecto en cualquier tipo de ventana.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    color: 'bg-eco-50 text-eco-600',
  },
];
---

<section id="servicios" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-block text-eco-600 font-semibold text-sm uppercase tracking-widest mb-3">Lo que hacemos</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Nuestros Servicios</h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        Ofrecemos una limpieza profesional y a fondo para todo tipo de espacios, tanto para particulares como para empresas.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <div class="group bg-white border border-gray-100 rounded-2xl p-7 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col">
          <div class={`w-16 h-16 rounded-xl flex items-center justify-center mb-5 ${service.color}`} set:html={service.icon}/>
          <h3 class="font-bold text-gray-900 text-lg mb-3">{service.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed flex-1">{service.description}</p>
          <a
            href="#contacto"
            class="mt-5 text-eco-600 hover:text-eco-700 font-semibold text-sm flex items-center gap-1 group-hover:gap-2 transition-all"
          >
            Pedir presupuesto
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Bottom CTA band -->
    <div class="mt-16 bg-eco-50 rounded-2xl p-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-bold text-eco-800 text-xl">¿Necesitas otro tipo de limpieza?</p>
        <p class="text-eco-700 mt-1">Cuéntanos qué necesitas y te preparamos un presupuesto sin compromiso.</p>
      </div>
      <a
        href="tel:+34605984005"
        class="flex-shrink-0 inline-flex items-center gap-2 bg-eco-600 hover:bg-eco-700 text-white px-7 py-3.5 rounded-xl font-bold transition-colors duration-200 shadow-sm"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        605 984 005
      </a>
    </div>

  </div>
</section>

        { item: 'Sofá 2 plazas', price: '70 – 100 €' },
        { item: 'Sofá 3 plazas', price: '90 – 140 €' },
        { item: 'Chaise long / Rinconera', price: '120 – 200 €' },
        { item: 'Colchón individual', price: '25 – 40 €' },
        { item: 'Colchón doble / Matrimonio', price: '40 – 70 €' },

      img: 'tapiceria-sofa.jpeg',
      detailLink: 'tapiceria' as const,
    },
    {
      title: 'Glass Cleaning',
      description: 'Windows, shower screens, shop fronts and glazed façades without streaks or residues. We use professional techniques and glass-specific products, with equipment for safe work at height.',

---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props { lang: Lang; page?: string; }
const { lang, page = '' } = Astro.props;
const tr = t(lang);

const raw = import.meta.env.BASE_URL;
const b = raw.endsWith('/') ? raw.slice(0, -1) : raw;
const langBase = lang === 'es' ? b : `${b}/${lang}`;
const pageSlug = page ? `${page}/` : '';

const navLinks = [
  { href: `${langBase}/servicios/`, label: tr.navServices },
  { href: `${langBase}/nosotros/`, label: tr.navAbout },
  { href: `${langBase}/referencias/`, label: tr.navReferences },
  { href: `${langBase}/zona/`, label: tr.navZone },
  { href: `${langBase}/contacto/`, label: tr.navContact },
];

const langPaths: Record<Lang, string> = {
  es: `${b}/${pageSlug}`,
  en: `${b}/en/${pageSlug}`,
  de: `${b}/de/${pageSlug}`,
};

const homeHref = lang === 'es' ? `${b}/` : `${b}/${lang}/`;
---

<div class="bg-eco-800 text-eco-100 text-xs py-2 hidden md:block">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
    <span>{tr.headerTagline}</span>
    <div class="flex items-center gap-6">
      <span>{tr.headerZone}</span>
      <a href="tel:+34605984005" class="hover:text-white transition-colors font-medium">+34 605 984 005</a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a href={homeHref} class="flex items-center gap-3">
        <div class="w-8 h-8 bg-eco-700 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M17.778 8.222A8 8 0 1 0 2.222 17.778C3.444 16 5 13 5 10c0-1.333.667-3 2-4 0 2 1 4 3 5 0-2 1-4 3-4-1 2-1 4 0 5 1-1 2-3 2-5 1.333 1.333 2 3 2 5 0 1-.5 2.5-2 4 2-1 3.5-3 3.778-6.778z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="leading-tight">
          <span class="font-bold text-gray-900 text-base tracking-tight block">ECO-LIMPIEZAS</span>
          <span class="text-eco-700 text-xs font-semibold tracking-widest block">EL VALLE</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {navLinks.map(link => (
          <a href={link.href}
            class="text-gray-600 hover:text-eco-700 font-medium transition-colors duration-150 uppercase tracking-wide text-xs">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right: Lang switcher + CTA -->
      <div class="hidden md:flex items-center gap-4">
        <div class="flex items-center border border-gray-200 divide-x divide-gray-200 text-xs font-bold">
          {(['es', 'en', 'de'] as Lang[]).map(l => (
            <a
              href={langPaths[l]}
              class={`px-3 py-1.5 transition-colors duration-150 ${lang === l ? 'bg-eco-700 text-white' : 'text-gray-500 hover:text-eco-700 hover:bg-gray-50'}`}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </div>
        <a href="tel:+34605984005"
          class="flex items-center gap-2 bg-eco-700 hover:bg-eco-800 text-white px-5 py-2.5 font-semibold text-sm transition-colors duration-150">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          605 984 005
        </a>
      </div>

      <!-- Mobile toggle -->
      <details class="lg:hidden group">
        <summary class="list-none cursor-pointer p-2 text-gray-600">
          <svg class="w-6 h-6 group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-6 h-6 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </summary>
        <div class="absolute top-full left-0 right-0 bg-white border-b border-gray-200 shadow-lg px-4 py-5 flex flex-col gap-4">
          {navLinks.map(link => (
            <a href={link.href} class="text-gray-700 hover:text-eco-700 font-medium py-1 text-sm uppercase tracking-wide transition-colors">
              {link.label}
            </a>
          ))}
          <div class="flex items-center gap-3 pt-2 border-t border-gray-100">
            <div class="flex items-center border border-gray-200 divide-x divide-gray-200 text-xs font-bold">
              {(['es', 'en', 'de'] as Lang[]).map(l => (
                <a
                  href={langPaths[l]}
                  class={`px-3 py-1.5 ${lang === l ? 'bg-eco-700 text-white' : 'text-gray-500 hover:text-eco-700'}`}
                >
                  {l.toUpperCase()}
                </a>
              ))}
            </div>
            <a href="tel:+34605984005"
              class="flex items-center gap-2 bg-eco-700 text-white px-4 py-2 font-semibold text-sm">
              605 984 005
            </a>
          </div>
        </div>
      </details>

    </div>
  </div>
</header>

---
const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#zona', label: 'Zona' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 bg-white shadow-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 group">
        <div class="w-9 h-9 bg-eco-600 rounded-lg flex items-center justify-center flex-shrink-0">
          <!-- Leaf icon -->
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M17.778 8.222A8 8 0 1 0 2.222 17.778C3.444 16 5 13 5 10c0-1.333.667-3 2-4 0 2 1 4 3 5 0-2 1-4 3-4-1 2-1 4 0 5 1-1 2-3 2-5 1.333 1.333 2 3 2 5 0 1-.5 2.5-2 4 2-1 3.5-3 3.778-6.778z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div>
          <span class="font-bold text-eco-800 text-lg leading-tight block">Eco-Limpiezas</span>
          <span class="text-eco-600 text-xs font-medium leading-none block">El Valle</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-gray-600 hover:text-eco-700 font-medium text-sm transition-colors duration-200 relative group"
          >
            {link.label}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-eco-600 group-hover:w-full transition-all duration-200"></span>
          </a>
        ))}
      </nav>

      <!-- CTA Phone Button -->
      <a
        href="tel:+34605984005"
        class="flex items-center gap-2 bg-eco-600 hover:bg-eco-700 text-white px-4 py-2 rounded-full font-semibold text-sm transition-colors duration-200 shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span class="hidden sm:inline">605 984 005</span>
        <span class="sm:hidden">Llamar</span>
      </a>

      <!-- Mobile menu toggle -->
      <details class="md:hidden group">
        <summary class="list-none cursor-pointer p-2 -mr-2 text-gray-600 hover:text-eco-700">
          <svg class="w-6 h-6 group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-6 h-6 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </summary>
        <div class="absolute top-full left-0 right-0 bg-white border-b border-gray-100 shadow-lg px-4 py-4 flex flex-col gap-4">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="text-gray-700 hover:text-eco-700 font-medium py-1 transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
      </details>

    </div>
  </div>
</header>

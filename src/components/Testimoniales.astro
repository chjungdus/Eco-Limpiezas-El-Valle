---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);

const reviews = [
  { name: 'M. Carmen R.', location: 'Espinosa de los Monteros', rating: 5, service: 'Limpieza doméstica', text: 'Llevo más de un año contratando a Davinia para la limpieza de mi casa y estoy muy satisfecha. Llega puntual, trabaja con mucho cuidado y deja todo impecable. Lo que más valoro es que se adapta perfectamente a mis horarios y que puedo confiar en ella plenamente. La recomiendo sin ninguna duda.' },
  { name: 'Jorge M.', location: 'Villarcayo', rating: 5, service: 'Limpieza de fin de obra', text: 'Contratamos a Eco-Limpiezas El Valle para la limpieza tras una reforma integral de nuestra casa. El resultado fue excelente: dejaron todo sin una mota de polvo y en un tiempo récord. El trato fue muy profesional desde el primer momento, con un presupuesto claro y sin sorpresas. Repetiría sin dudarlo.' },
  { name: 'Ana B.', location: 'Medina de Pomar', rating: 5, service: 'Limpieza de tapicería', text: 'Le pedí a Davinia que limpiara el sofá y el colchón de mi habitación. El cambio fue increíble, especialmente en el sofá que tenía manchas que yo creía imposibles de eliminar. El proceso fue rápido, no dejó ningún olor y el tiempo de secado fue mucho menor de lo que esperaba. Un servicio excelente.' },
  { name: 'Roberto A.', location: 'Trespaderne', rating: 5, service: 'Limpieza de oficina', text: 'Buscábamos una empresa de limpieza para nuestra oficina y encontramos a Eco-Limpiezas El Valle. Lo que más nos convenció fue la flexibilidad horaria: pueden venir fuera del horario de trabajo, lo que no interfiere con nuestra actividad. El servicio es de alta calidad y el trato muy profesional.' },
  { name: 'Isabel F.', location: 'Espinosa de los Monteros', rating: 5, service: 'Limpieza de cristales', text: 'Tengo una casa con muchas ventanas grandes y la limpieza de cristales siempre había sido un problema para mí. Desde que lo hace Davinia, los cristales quedan perfectos, sin ningún tipo de marca o velo. Además usa productos ecológicos, lo que para mí es importante. Estoy muy contenta con el servicio.' },
  { name: 'Hostal El Valle', location: 'Las Merindades', rating: 5, service: 'Limpieza de establecimiento', text: 'Contamos con Eco-Limpiezas El Valle para el mantenimiento diario de nuestro establecimiento hostelero. Su fiabilidad y profesionalidad son fundamentales para nosotros: necesitamos que el trabajo esté hecho a tiempo y bien hecho, y nunca nos han fallado. Además, el uso de productos ecológicos encaja perfectamente con nuestros valores.' },
];

function renderStars(count: number) {
  return Array.from({ length: 5 }, (_, i) => i < count ? '★' : '☆').join('');
}
---

<section class="py-20 md:py-28 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-16 border-l-4 border-eco-600 pl-6">
      <span class="text-eco-700 font-semibold text-sm uppercase tracking-widest block mb-2">{tr.sectionTestLabel}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{tr.sectionTestTitle}</h2>
      <p class="text-gray-500 text-lg max-w-3xl">{tr.sectionTestSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-200">
      {reviews.map(review => (
        <div class="bg-white p-8 flex flex-col">
          <div class="text-eco-500 text-lg mb-4 tracking-wider">{renderStars(review.rating)}</div>
          <p class="text-gray-600 leading-relaxed mb-6 flex-1 text-sm">"{review.text}"</p>
          <div class="pt-4 border-t border-gray-100">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-bold text-gray-900">{review.name}</p>
                <p class="text-gray-400 text-sm">{review.location}</p>
              </div>
              <span class="text-xs bg-eco-50 text-eco-700 border border-eco-200 px-2 py-1 font-medium whitespace-nowrap">{review.service}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 bg-eco-800 p-8 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="flex items-center gap-6">
        <div class="text-center">
          <div class="text-5xl font-extrabold text-white">5,0</div>
          <div class="text-eco-400 text-xs uppercase tracking-widest mt-1">{tr.testAverageLabel}</div>
        </div>
        <div>
          <div class="text-eco-300 text-2xl tracking-wider mb-1">★★★★★</div>
          <p class="text-eco-400 text-sm">{tr.testBasedOn} {reviews.length} {tr.testBasedOnSuffix}</p>
        </div>
      </div>
      <div class="text-center md:text-right">
        <p class="text-eco-200 text-lg font-medium mb-1">{tr.testFeedbackTitle}</p>
        <p class="text-eco-400 text-sm mb-4">{tr.testFeedbackText}</p>
        <a href="tel:+34605984005"
          class="inline-flex items-center gap-2 bg-white text-eco-800 hover:bg-eco-50 px-6 py-2.5 font-bold text-sm transition-colors duration-150">
          {tr.testContactBtn}
        </a>
      </div>
    </div>

  </div>
</section>

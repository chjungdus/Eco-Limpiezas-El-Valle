---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = 'es', title, description } = Astro.props;
const tr = t(lang);
const pageTitle = title ?? tr.siteTitle;
const pageDesc = description ?? tr.siteDescription;
const ogLocale = { es: 'es_ES', en: 'en_GB', de: 'de_DE' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Local Business Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Eco-Limpiezas El Valle",
        "telephone": "+34605984005",
        "areaServed": [
          "Espinosa de los Monteros",
          "Las Merindades",
          "Burgos"
        ],
        "serviceType": [
          "Limpieza doméstica",
          "Limpieza de fin de obra",
          "Limpieza de tapicerías",
          "Limpieza de cristales"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+34605984005",
          "contactType": "customer service",
          "availableLanguage": ["Spanish", "English", "German"]
        },
        "employee": {
          "@type": "Person",
          "name": "Davinia Gómez Baranda"
        }
      }
    </script>

    <style>
      html {
        scroll-behavior: smooth;
        font-family: 'Inter', system-ui, sans-serif;
      }
      * {
        box-sizing: border-box;
      }
    </style>
  </head>
  <body class="bg-white text-gray-800 antialiased">
    <slot />
  </body>
</html>
